<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="SR Self Study Zone & Library — Shahdol's premier study library. Reserve dedicated study seats with AC, High-Speed WiFi, Lockers, and 24/7 Power Backup." />
  <title>
    <%= title %>
  </title>
  <link rel="icon" href="/images/logo.jpg" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    /* Navbar enhancements */
    .header-nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      height: 68px;
      display: flex;
      align-items: center;
    }

    .header-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .nav-brand-img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .nav-brand-text {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 800;
      color: var(--primary-dark);
      letter-spacing: -0.02em;
    }

    .nav-menu-links {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .nav-item-link {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 600;
      transition: var(--transition);
      text-decoration: none;
    }

    .nav-item-link:hover {
      color: var(--primary);
    }

    .nav-login-btn {
      background: var(--primary);
      color: #fff !important;
      padding: 9px 18px;
      border-radius: var(--radius);
      font-size: 13.5px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
      box-shadow: 0 2px 8px rgba(26, 35, 126, 0.25);
    }

    .nav-login-btn:hover {
      background: var(--primary-light);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(26, 35, 126, 0.35);
    }

    .nav-mobile-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 24px;
      color: var(--text-primary);
      cursor: pointer;
      padding: 6px;
    }

    /* Mobile drawer */
    .mobile-drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 1050;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
    }

    .mobile-drawer-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -290px;
      width: 280px;
      height: 100%;
      background: #ffffff;
      z-index: 1060;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: var(--shadow-xl);
      transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-drawer.active {
      right: 0;
    }

    .mobile-drawer-close {
      align-self: flex-end;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      width: 36px;
      height: 36px;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-drawer-link {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      padding: 12px 14px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      transition: var(--transition);
    }

    .mobile-drawer-link:hover,
    .mobile-drawer-link.active {
      background: var(--surface-2);
      color: var(--primary);
    }

    /* Hero section */
    .hero-lib {
      padding: 64px 20px 56px;
      background: linear-gradient(135deg, #0d1b6e 0%, #1a237e 60%, #283593 100%);
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    .hero-lib::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: radial-gradient(circle at 85% 20%, rgba(255, 214, 0, 0.12) 0%, transparent 50%);
      pointer-events: none;
    }

    .hero-lib-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
      position: relative;
      z-index: 2;
    }

    .hero-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.22);
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      color: #ffeb3b;
      margin-bottom: 18px;
    }

    .hero-heading {
      font-size: clamp(2rem, 4.5vw, 3.2rem);
      line-height: 1.15;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .hero-heading span {
      color: #ffd600;
    }

    .hero-subtext {
      font-size: clamp(14.5px, 2vw, 17px);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.88);
      max-width: 540px;
      margin-bottom: 28px;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn-hero-primary {
      background: #ffd600;
      color: #0d1b6e !important;
      padding: 13px 26px;
      border-radius: var(--radius);
      font-size: 15px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 18px rgba(255, 214, 0, 0.35);
      transition: var(--transition);
    }

    .btn-hero-primary:hover {
      background: #ffea00;
      transform: translateY(-2px);
      box-shadow: 0 6px 22px rgba(255, 214, 0, 0.45);
    }

    .btn-hero-secondary {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #ffffff !important;
      padding: 13px 24px;
      border-radius: var(--radius);
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: var(--transition);
    }

    .btn-hero-secondary:hover {
      background: rgba(255, 255, 255, 0.22);
      transform: translateY(-2px);
    }

    .hero-card-img {
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      border: 3px solid rgba(255, 255, 255, 0.2);
      aspect-ratio: 16/11;
      width: 100%;
    }

    .hero-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Live Availability Strip */
    .live-strip {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 18px 20px;
    }

    .live-strip-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .live-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .live-pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #16a34a;
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    }

    .live-strip-details {
      display: flex;
      align-items: center;
      gap: 24px;
      font-size: 13.5px;
      color: var(--text-secondary);
      flex-wrap: wrap;
    }

    /* Step flow */
    .step-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      text-align: center;
      position: relative;
      transition: var(--transition);
    }

    .step-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: rgba(26, 35, 126, 0.2);
    }

    .step-num-bubble {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 16px;
      box-shadow: 0 3px 10px rgba(26, 35, 126, 0.25);
    }

    /* Facility card */
    .fac-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: var(--transition);
    }

    .fac-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: rgba(26, 35, 126, 0.25);
    }

    .fac-icon-circle {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #eef2ff;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    /* Media query adjustments */
    @media (max-width: 900px) {
      .hero-lib-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-subtext {
        margin: 0 auto 28px;
      }

      .hero-cta-group {
        justify-content: center;
      }

      .hero-card-img {
        max-width: 520px;
        margin: 0 auto;
      }

      .nav-menu-links {
        display: none;
      }

      .nav-mobile-toggle {
        display: block;
      }
    }
  </style>
</head>

<body>

  <!-- Floating WhatsApp Contact Button -->
  <a href="https://wa.me/918103485288" class="whatsapp-float" target="_blank" rel="noopener noreferrer"
    aria-label="Chat with SR Library on WhatsApp" title="WhatsApp Us">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer-overlay" id="drawerOverlay" onclick="toggleMobileDrawer()"></div>
  <div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <button class="mobile-drawer-close" onclick="toggleMobileDrawer()" aria-label="Close Menu">&times;</button>
    <a href="/" class="nav-brand" style="margin-bottom:8px;">
      <img src="/images/logo.jpg" alt="Logo" class="nav-brand-img" />
      <span class="nav-brand-text">
        <%= libraryName %>
      </span>
    </a>
    <a href="/" class="mobile-drawer-link active"><i class="fa-solid fa-house"></i> Home</a>
    <a href="/about.html" class="mobile-drawer-link"><i class="fa-solid fa-building-columns"></i> About Library</a>
    <a href="#facilities" class="mobile-drawer-link" onclick="toggleMobileDrawer()"><i
        class="fa-solid fa-layer-group"></i> Facilities</a>
    <a href="#how-it-works" class="mobile-drawer-link" onclick="toggleMobileDrawer()"><i
        class="fa-solid fa-list-check"></i> How It Works</a>
    <a href="/seat-availability" class="mobile-drawer-link"><i class="fa-solid fa-chair"></i> Seat Availability</a>
    <a href="/contact.html" class="mobile-drawer-link"><i class="fa-solid fa-phone"></i> Contact</a>
    <div
      style="margin-top:auto;padding-top:16px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:10px;">
      <a href="/student/login" class="btn btn-primary btn-block" style="justify-content:center;">
        <i class="fa-solid fa-user-graduate"></i> Student Login
      </a>
      <a href="/admin/login" class="btn btn-ghost btn-block" style="justify-content:center;font-size:13px;">
        <i class="fa-solid fa-shield-halved"></i> Admin Portal
      </a>
    </div>
  </div>

  <!-- Header / Navigation Bar -->
  <header class="header-nav">
    <div class="header-container">
      <a href="/" class="nav-brand">
        <img src="/images/logo.jpg" alt="SR Library Logo" class="nav-brand-img" />
        <span class="nav-brand-text">
          <%= libraryName %>
        </span>
      </a>

      <!-- Desktop Links -->
      <nav class="nav-menu-links">
        <a href="/" class="nav-item-link" style="color:var(--primary);font-weight:700;">Home</a>
        <a href="/about.html" class="nav-item-link">About</a>
        <a href="#facilities" class="nav-item-link">Facilities</a>
        <a href="#how-it-works" class="nav-item-link">How It Works</a>
        <a href="/seat-availability" class="nav-item-link">Seats</a>
        <a href="/contact.html" class="nav-item-link">Contact</a>
        <a href="/student/login" class="nav-login-btn">
          <i class="fa-solid fa-user-graduate"></i> Student Login
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button class="nav-mobile-toggle" onclick="toggleMobileDrawer()" aria-label="Open Navigation Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </header>

  <!-- ─── HERO SECTION ────────────────────────────────────────────────── -->
  <section class="hero-lib">
    <div class="hero-lib-inner">
      <div>
        <div class="hero-badge-pill">
          <i class="fa-solid fa-star"></i> Shahdol's Premier Self-Study Zone
        </div>
        <h1 class="hero-heading">
          Study Better.<br />
          <span>Focus Better.</span>
        </h1>
        <p class="hero-subtext">
          Reserve your dedicated, quiet study seat equipped with high-speed Wi-Fi, air conditioning, and personal power
          sockets. Build your tomorrow today.
        </p>
        <div class="hero-cta-group">
          <a href="/seat-availability" class="btn-hero-primary" id="heroBookSeatBtn">
            <i class="fa-solid fa-chair"></i> Book a Seat
          </a>
          <a href="/student/login" class="btn-hero-secondary" id="heroStudentLoginBtn">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Student Login
          </a>
        </div>
      </div>

      <div class="hero-card-img">
        <img src="/images/gallery1.jpeg" alt="SR Library Study Room" loading="eager" />
      </div>
    </div>
  </section>

  <!-- ─── LIVE SEAT AVAILABILITY STRIP ───────────────────────────────── -->
  <section class="live-strip">
    <div class="live-strip-inner">
      <div class="live-status-badge">
        <span class="live-pulse-dot"></span>
        <span>Physical Seats: <strong>
            <%= typeof totalSeats !=='undefined' ? totalSeats : 40 %> Available
          </strong> across Section A & B</span>
      </div>
      <div class="live-strip-details">
        <span><i class="fa-regular fa-clock" style="color:var(--primary);"></i> Daily: <strong>6:00 AM – 11:00
            PM</strong></span>
        <span><i class="fa-solid fa-location-dot" style="color:var(--primary);"></i> <strong>Shahdol,
            M.P.</strong></span>
        <a href="/seat-availability" class="btn btn-sm btn-outline" style="font-size:12.5px;">View Live Seat Map →</a>
      </div>
    </div>
  </section>

  <!-- ─── FACILITIES SECTION ─────────────────────────────────────────── -->
  <section class="section" id="facilities" style="background:var(--bg);">
    <div class="container">
      <div style="text-align:center;max-width:640px;margin:0 auto 44px;">
        <span class="badge badge-primary" style="margin-bottom:10px;">Built for Focus</span>
        <h2 style="font-size:clamp(1.6rem,3vw,2.3rem);margin-bottom:10px;">Library Facilities</h2>
        <p style="color:var(--text-muted);font-size:15px;">
          Carefully designed study atmosphere with every essential amenity for competitive exam aspirants.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:20px;">
        <!-- 1. Comfortable Study Seats -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-chair"></i></div>
          <h3 style="font-size:16px;margin:0;">Comfortable Study Seats</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Spacious, dedicated desks with posture-friendly ergonomic chairs for long study hours without fatigue.
          </p>
        </div>

        <!-- 2. High-Speed Wi-Fi -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-wifi"></i></div>
          <h3 style="font-size:16px;margin:0;">High-Speed Wi-Fi</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            High-speed optical fiber internet for uninterrupted online video lectures, test series, and research.
          </p>
        </div>

        <!-- 3. Peaceful Environment -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-volume-xmark"></i></div>
          <h3 style="font-size:16px;margin:0;">Peaceful Environment</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Strictly maintained silence zone ensuring 100% distraction-free deep concentration for serious aspirants.
          </p>
        </div>

        <!-- 4. Power Backup -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-bolt"></i></div>
          <h3 style="font-size:16px;margin:0;">100% Power Backup</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Full inverter & generator power backup so your learning is never interrupted during power outages.
          </p>
        </div>

        <!-- 5. Air Conditioning -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-snowflake"></i></div>
          <h3 style="font-size:16px;margin:0;">Air Conditioning</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Evenly cooled, temperature-controlled environment providing maximum comfort in all seasons.
          </p>
        </div>

        <!-- 6. CCTV Security -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-video"></i></div>
          <h3 style="font-size:16px;margin:0;">24/7 CCTV Surveillance</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Full round-the-clock camera monitoring ensuring complete safety for students and their belongings.
          </p>
        </div>

        <!-- 7. Purified RO Water -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-bottle-water"></i></div>
          <h3 style="font-size:16px;margin:0;">RO Drinking Water</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Hygienic, multi-stage RO purified chilled and normal drinking water dispenser available continuously.
          </p>
        </div>

        <!-- 8. Long Study Hours -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-clock"></i></div>
          <h3 style="font-size:16px;margin:0;">Long Study Hours</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Open 7 days a week from 6:00 AM to 11:00 PM to accommodate early risers and late-night study routines.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── HOW SEAT BOOKING WORKS ─────────────────────────────────────── -->
  <section class="section" id="how-it-works"
    style="background:#ffffff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container">
      <div style="text-align:center;max-width:600px;margin:0 auto 44px;">
        <span class="badge badge-primary" style="margin-bottom:10px;">Simple Process</span>
        <h2 style="font-size:clamp(1.6rem,3vw,2.3rem);margin-bottom:10px;">How Seat Booking Works</h2>
        <p style="color:var(--text-muted);font-size:15px;">Book and reserve your study seat in four easy steps.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(230px, 1fr));gap:20px;">
        <div class="step-card">
          <div class="step-num-bubble">1</div>
          <h3 style="font-size:16px;margin-bottom:8px;">Create Account</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Register with your name, phone number, and address.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num-bubble">2</div>
          <h3 style="font-size:16px;margin-bottom:8px;">Login</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Access your student portal using your registered mobile or email.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num-bubble">3</div>
          <h3 style="font-size:16px;margin-bottom:8px;">Select Seat</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Pick an available seat from Section A or Section B on the interactive map.
          </p>
        </div>

        <div class="step-card">
          <div class="step-num-bubble">4</div>
          <h3 style="font-size:16px;margin-bottom:8px;">Confirm Booking</h3>
          <p style="font-size:13.5px;color:var(--text-muted);margin:0;line-height:1.5;">
            Receive your booking confirmation instantly and start studying.
          </p>
        </div>
      </div>

      <div style="text-align:center;margin-top:36px;">
        <a href="/seat-availability" class="btn btn-primary btn-lg">
          <i class="fa-solid fa-chair"></i> View Available Seats Now
        </a>
      </div>
    </div>
  </section>

  <!-- ─── STUDY ENVIRONMENT & GALLERY ─────────────────────────────────── -->
  <section class="section" id="gallery" style="background:var(--bg);">
    <div class="container">
      <div style="text-align:center;max-width:600px;margin:0 auto 40px;">
        <span class="badge badge-primary" style="margin-bottom:10px;">Our Space</span>
