<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="SR Self Study Zone & Library — Shahdol's premier study library. Reserve dedicated study seats with AC, High-Speed WiFi, Lockers, and 24/7 Power Backup." />
  <title><%= title %></title>
  <link rel="icon" href="/images/logo.jpg" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    /* Navbar styles */
    .header-nav {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      height: 68px;
      display: flex;
      align-items: center;
    }

    .header-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .nav-brand-img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .nav-brand-text {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 800;
      color: var(--primary-dark);
      letter-spacing: -0.02em;
    }

    .nav-menu-links {
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .nav-item-link {
      color: var(--text-secondary);
      font-size: 14px;
      font-weight: 600;
      transition: var(--transition);
      text-decoration: none;
      padding: 6px 4px;
    }

    .nav-item-link:hover {
      color: var(--primary);
    }

    .nav-login-btn {
      background: var(--primary);
      color: #fff !important;
      padding: 9px 18px;
      border-radius: var(--radius);
      font-size: 13.5px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
      box-shadow: 0 2px 8px rgba(26, 35, 126, 0.25);
      text-decoration: none;
    }

    .nav-login-btn:hover {
      background: var(--primary-light);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(26, 35, 126, 0.35);
    }

    .nav-mobile-toggle {
      display: none;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--primary-dark);
      cursor: pointer;
      padding: 8px 12px;
      font-size: 18px;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .nav-mobile-toggle:hover {
      background: #eef2ff;
      border-color: #cbd5e1;
    }

    /* Mobile drawer */
    .mobile-drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(4px);
      z-index: 1050;
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
    }

    .mobile-drawer-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -310px;
      width: 290px;
      max-width: 85vw;
      height: 100%;
      background: #ffffff;
      z-index: 1060;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: var(--shadow-xl);
      transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }

    .mobile-drawer.active {
      right: 0;
    }

    .mobile-drawer-close {
      align-self: flex-end;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      width: 36px;
      height: 36px;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .mobile-drawer-link {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      padding: 12px 14px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      transition: var(--transition);
    }

    .mobile-drawer-link:hover,
    .mobile-drawer-link.active {
      background: #eef2ff;
      color: var(--primary);
    }

    .mobile-drawer-link i {
      width: 20px;
      text-align: center;
      color: var(--primary);
      font-size: 16px;
    }

    /* Floating WhatsApp Button */
    .whatsapp-float {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 56px;
      height: 56px;
      background: #25d366;
      color: #ffffff !important;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 4px 18px rgba(37, 211, 102, 0.4);
      z-index: 1000;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      text-decoration: none;
    }

    .whatsapp-float:hover {
      transform: scale(1.08);
      box-shadow: 0 6px 24px rgba(37, 211, 102, 0.55);
      color: #ffffff;
    }

    /* Hero section */
    .hero-lib {
      padding: 64px 20px 56px;
      background: linear-gradient(135deg, #0d1b6e 0%, #1a237e 60%, #283593 100%);
      color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    .hero-lib::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 85% 20%, rgba(255, 214, 0, 0.12) 0%, transparent 50%);
      pointer-events: none;
    }

    .hero-lib-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 40px;
      align-items: center;
      position: relative;
      z-index: 2;
    }

    .hero-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.22);
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 600;
      color: #ffeb3b;
      margin-bottom: 18px;
    }

    .hero-heading {
      font-size: clamp(2rem, 4.5vw, 3.2rem);
      line-height: 1.15;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .hero-heading span {
      color: #ffd600;
    }

    .hero-subtext {
      font-size: clamp(14.5px, 2vw, 17px);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.88);
      max-width: 540px;
      margin-bottom: 28px;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn-hero-primary {
      background: #ffd600;
      color: #0d1b6e !important;
      padding: 13px 26px;
      border-radius: var(--radius);
      font-size: 15px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      box-shadow: 0 4px 18px rgba(255, 214, 0, 0.35);
      transition: var(--transition);
    }

    .btn-hero-primary:hover {
      background: #ffea00;
      transform: translateY(-2px);
      box-shadow: 0 6px 22px rgba(255, 214, 0, 0.45);
    }

    .btn-hero-secondary {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.35);
      color: #ffffff !important;
      padding: 13px 24px;
      border-radius: var(--radius);
      font-size: 15px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: var(--transition);
    }

    .btn-hero-secondary:hover {
      background: rgba(255, 255, 255, 0.22);
      transform: translateY(-2px);
    }

    .hero-card-img {
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      border: 3px solid rgba(255, 255, 255, 0.2);
      aspect-ratio: 16/11;
      width: 100%;
    }

    .hero-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Live Availability Strip */
    .live-strip {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 16px 20px;
    }

    .live-strip-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .live-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .live-pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #16a34a;
      box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    }

    .live-strip-details {
      display: flex;
      align-items: center;
      gap: 20px;
      font-size: 13.5px;
      color: var(--text-secondary);
      flex-wrap: wrap;
    }

    /* About Section */
    .about-section {
      padding: 64px 20px;
      background: #ffffff;
      border-bottom: 1px solid var(--border);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-image-stack {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .about-photo {
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      aspect-ratio: 4/3;
    }

    .about-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .about-photo:hover img {
      transform: scale(1.03);
    }

    .about-highlights-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 24px;
    }

    .about-highlight-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13.5px;
      color: var(--text-secondary);
    }

    .about-highlight-item i {
      color: var(--primary);
      font-size: 15px;
      margin-top: 3px;
      flex-shrink: 0;
    }

    /* Facility card */
    .fac-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: var(--transition);
      height: 100%;
    }

    .fac-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: rgba(26, 35, 126, 0.25);
    }

    .fac-icon-circle {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: #eef2ff;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    /* Step flow */
    .step-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px 18px;
      text-align: center;
      position: relative;
      transition: var(--transition);
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .step-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
      border-color: rgba(26, 35, 126, 0.2);
    }

    .step-num-bubble {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 16px;
      margin-bottom: 14px;
      box-shadow: 0 3px 10px rgba(26, 35, 126, 0.25);
    }

    /* Media query adjustments */
    @media (max-width: 900px) {
      .hero-lib-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-subtext {
        margin: 0 auto 28px;
      }

      .hero-cta-group {
        justify-content: center;
      }

      .hero-card-img {
        max-width: 500px;
        margin: 0 auto;
      }

      .about-grid {
        grid-template-columns: 1fr;
      }

      .nav-menu-links {
        display: none;
      }

      .nav-mobile-toggle {
        display: flex;
      }
    }

    @media (max-width: 640px) {
      .about-highlights-grid {
        grid-template-columns: 1fr;
      }
      .about-image-stack {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- Floating WhatsApp Contact Button -->
  <a href="https://wa.me/918103485288" class="whatsapp-float" target="_blank" rel="noopener noreferrer"
    aria-label="Chat with SR Library on WhatsApp" title="WhatsApp Us">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer-overlay" id="drawerOverlay" onclick="closeMobileDrawer()"></div>
  <div class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <button class="mobile-drawer-close" onclick="closeMobileDrawer()" aria-label="Close Menu">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <a href="/" class="nav-brand" style="margin-bottom:8px;">
      <img src="/images/logo.jpg" alt="Logo" class="nav-brand-img" />
      <span class="nav-brand-text">
        <%= libraryName %>
      </span>
    </a>
    <a href="/" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-house"></i> Home
    </a>
    <a href="#about" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-building-columns"></i> About Library
    </a>
    <a href="#facilities" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-layer-group"></i> Facilities
    </a>
    <a href="#how-it-works" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-list-check"></i> How It Works
    </a>
    <a href="/seat-availability" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-chair"></i> 43-Seat Layout
    </a>
    <a href="#contact" class="mobile-drawer-link" onclick="closeMobileDrawer()">
      <i class="fa-solid fa-phone"></i> Contact
    </a>
    <div
      style="margin-top:auto;padding-top:16px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:10px;">
      <a href="/student/login" class="btn btn-primary btn-block" style="justify-content:center;">
        <i class="fa-solid fa-user-graduate"></i> Student Login
      </a>
      <a href="/admin/login" class="btn btn-ghost btn-block" style="justify-content:center;font-size:13px;">
        <i class="fa-solid fa-shield-halved"></i> Admin Portal
      </a>
    </div>
  </div>

  <!-- Header / Navigation Bar -->
  <header class="header-nav">
    <div class="header-container">
      <a href="/" class="nav-brand">
        <img src="/images/logo.jpg" alt="SR Library Logo" class="nav-brand-img" />
        <span class="nav-brand-text">
          <%= libraryName %>
        </span>
      </a>

      <!-- Desktop Links -->
      <nav class="nav-menu-links">
        <a href="/" class="nav-item-link" style="color:var(--primary);font-weight:700;">Home</a>
        <a href="#about" class="nav-item-link">About</a>
        <a href="#facilities" class="nav-item-link">Facilities</a>
        <a href="#how-it-works" class="nav-item-link">How It Works</a>
        <a href="/seat-availability" class="nav-item-link">43 Seats</a>
        <a href="#contact" class="nav-item-link">Contact</a>
        <a href="/student/login" class="nav-login-btn">
          <i class="fa-solid fa-user-graduate"></i> Student Login
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <button class="nav-mobile-toggle" onclick="toggleMobileDrawer()" aria-label="Open Navigation Menu">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </header>

  <!-- ─── HERO SECTION ────────────────────────────────────────────────── -->
  <section class="hero-lib">
    <div class="hero-lib-inner">
      <div>
        <div class="hero-badge-pill">
          <i class="fa-solid fa-star"></i> Shahdol's Premier Self-Study Zone
        </div>
        <h1 class="hero-heading">
          Study Better.<br />
          <span>Focus Better.</span>
        </h1>
        <p class="hero-subtext">
          Reserve your dedicated, quiet study seat equipped with high-speed Wi-Fi, air conditioning, and personal power
          sockets. Build your tomorrow today.
        </p>
        <div class="hero-cta-group">
          <a href="/seat-availability" class="btn-hero-primary" id="heroBookSeatBtn">
            <i class="fa-solid fa-chair"></i> View 43 Seats
          </a>
          <a href="/student/login" class="btn-hero-secondary" id="heroStudentLoginBtn">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> Student Login
          </a>
        </div>
      </div>

      <div class="hero-card-img">
        <img src="/images/gallery1.jpeg" alt="SR Library Study Room" loading="eager" />
      </div>
    </div>
  </section>

  <!-- ─── LIVE SEAT AVAILABILITY STRIP ───────────────────────────────── -->
  <section class="live-strip">
    <div class="live-strip-inner">
      <div class="live-status-badge">
        <span class="live-pulse-dot"></span>
        <span>Physical Study Hall: <strong><%= typeof availableSeats !== 'undefined' ? availableSeats : 36 %> Desks Available</strong> (43 Total)</span>
      </div>
      <div class="live-strip-details">
        <span><i class="fa-regular fa-clock" style="color:var(--primary);"></i> Daily: <strong>6:00 AM – 11:00 PM</strong></span>
        <span><i class="fa-solid fa-location-dot" style="color:var(--primary);"></i> <strong>Shahdol, M.P.</strong></span>
        <a href="/seat-availability" class="btn btn-sm btn-outline" style="font-size:12.5px;">View 43-Seat Layout →</a>
      </div>
    </div>
  </section>

  <!-- ─── ABOUT SECTION (REORGANIZED) ────────────────────────────────── -->
  <section class="about-section" id="about">
    <div class="about-grid">
      <div>
        <span class="badge badge-primary" style="margin-bottom:10px;">About SR Library</span>
        <h2 style="font-size:clamp(1.7rem,3vw,2.3rem);margin-bottom:14px;font-weight:800;">
          A Dedicated Environment Built for <span style="color:var(--primary);">Serious Students</span>
        </h2>
        <p style="color:var(--text-secondary);font-size:15px;line-height:1.7;margin-bottom:14px;">
          <strong>SR Self Study Zone &amp; Library</strong> in Shahdol, Madhya Pradesh provides serious competitive exam aspirants with a world-class, peaceful, and disciplined study environment without having to relocate to a metro city.
        </p>
        <p style="color:var(--text-secondary);font-size:15px;line-height:1.7;margin-bottom:20px;">
          Whether you are preparing for UPSC, MPPSC, SSC, Banking, Railways, Defense, or State Examinations, our hall is specifically designed to maximize deep concentration and minimize daily fatigue.
        </p>

        <div class="about-highlights-grid">
          <div class="about-highlight-item">
            <i class="fa-solid fa-volume-xmark"></i>
            <div>
              <strong>Strict Silence Zone</strong>
              <div>Zero noise and distraction-free hall</div>
            </div>
          </div>
          <div class="about-highlight-item">
            <i class="fa-solid fa-wifi"></i>
            <div>
              <strong>High-Speed Wi-Fi</strong>
              <div>Optical fiber connection for lectures</div>
            </div>
          </div>
          <div class="about-highlight-item">
            <i class="fa-solid fa-bolt"></i>
            <div>
              <strong>24/7 Power Backup</strong>
              <div>Inverter and generator backup</div>
            </div>
          </div>
          <div class="about-highlight-item">
            <i class="fa-solid fa-snowflake"></i>
            <div>
              <strong>Fully Air Conditioned</strong>
              <div>Comfortable study environment all year</div>
            </div>
          </div>
          <div class="about-highlight-item">
            <i class="fa-solid fa-video"></i>
            <div>
              <strong>CCTV Surveillance</strong>
              <div>24-hour monitoring for safety</div>
            </div>
          </div>
          <div class="about-highlight-item">
            <i class="fa-solid fa-bottle-water"></i>
            <div>
              <strong>Purified RO Water</strong>
              <div>Hygienic drinking water dispenser</div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-image-stack">
        <div class="about-photo">
          <img src="/images/gallery1.jpeg" alt="Study Hall Interior" loading="lazy" />
        </div>
        <div class="about-photo">
          <img src="/images/office.jpeg" alt="Library Reception" loading="lazy" />
        </div>
        <div class="about-photo">
          <img src="/images/coridoor.jpeg" alt="Clean Corridor" loading="lazy" />
        </div>
        <div class="about-photo">
          <img src="/images/gallery3.jpeg" alt="Study Desk Setup" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FACILITIES SECTION ─────────────────────────────────────────── -->
  <section class="section" id="facilities" style="background:var(--bg);">
    <div class="container">
      <div style="text-align:center;max-width:640px;margin:0 auto 40px;">
        <span class="badge badge-primary" style="margin-bottom:10px;">Library Facilities</span>
        <h2 style="font-size:clamp(1.6rem,3vw,2.3rem);margin-bottom:10px;">Designed for Maximum Productivity</h2>
        <p style="color:var(--text-muted);font-size:15px;">
          Every facility you need to stay focused, comfortable, and consistent during your study marathon.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:20px;">
        <!-- 1. Comfortable Study Seats -->
        <div class="fac-card">
          <div class="fac-icon-circle"><i class="fa-solid fa-chair"></i></div>
          <h3 style="font-size:16px;margin:0;font-weight:700;">43 Ergonomic Desks</h3>
