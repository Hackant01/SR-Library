            </div>
        </div>
        <div class="testimonial-controls reveal">
            <div class="t-dot active"></div>
            <div class="t-dot"></div>
        </div>
    </section>

    <!-- ────────────────── PRICING PREVIEW ────────────────── -->
    <section class="section" id="pricing-preview">
        <div class="section-header reveal">
            <span class="section-label">Library Plans</span>
            <h2 class="section-title">Affordable Plans for <span>Every Student</span></h2>
            <p class="section-sub">Choose the plan that fits your study schedule. Registration fee ₹150 (one time only).
            </p>
        </div>
        <div class="pricing-grid">
            <div class="price-card reveal">
                <div class="price-icon">🌅</div>
                <h3>4 Hours</h3>
                <div class="price-row"><span>1 Month</span><span class="amount">₹500</span></div>
                <div class="price-row"><span>2 Months</span><span class="amount">₹900</span></div>
                <div class="price-row"><span>3 Months</span><span class="amount">₹1300</span></div>
                <a href="/student/register" class="price-cta" id="price-4hr-btn">Register (₹150)</a>
            </div>
            <div class="price-card reveal">
                <div class="price-icon">☀️</div>
                <h3>6 Hours</h3>
                <div class="price-row"><span>1 Month</span><span class="amount">₹700</span></div>
                <div class="price-row"><span>2 Months</span><span class="amount">₹1300</span></div>
                <div class="price-row"><span>3 Months</span><span class="amount">₹1900</span></div>
                <a href="/student/register" class="price-cta" id="price-6hr-btn">Register (₹150)</a>
            </div>
            <div class="price-card reveal">
                <div class="price-icon">🌇</div>
                <h3>8 Hours</h3>
                <div class="price-row"><span>1 Month</span><span class="amount">₹900</span></div>
                <div class="price-row"><span>2 Months</span><span class="amount">₹1700</span></div>
                <div class="price-row"><span>3 Months</span><span class="amount">₹2500</span></div>
                <a href="/student/register" class="price-cta" id="price-8hr-btn">Register (₹150)</a>
            </div>
            <div class="price-card popular reveal">
