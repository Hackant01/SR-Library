<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="View real-time physical seat availability at <%= libraryName %> — Exactly 43 study desks." />
  <title><%= title %></title>
  <link rel="icon" href="/images/logo.jpg" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/seating.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body style="background:var(--bg);min-height:100vh;display:flex;flex-direction:column;">

  <!-- Floating WhatsApp Contact Button -->
  <a href="https://wa.me/918103485288" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat with SR Library on WhatsApp" title="WhatsApp Us">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- Header -->
  <header style="background:#fff;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:1000;">
    <div style="max-width:1200px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
        <img src="/images/logo.jpg" alt="Logo" style="width:38px;height:38px;border-radius:8px;object-fit:cover;" />
        <span style="font-family:var(--font-display);font-weight:800;font-size:18px;color:var(--primary-dark);"><%= libraryName %></span>
      </a>
      <div style="display:flex;align-items:center;gap:12px;">
        <a href="/" class="btn btn-ghost btn-sm"><i class="fa-solid fa-house"></i> Home</a>
        <a href="/student/login" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-user-graduate"></i> Student Login
        </a>
      </div>
    </div>
  </header>

  <!-- Page Main Content -->
  <main style="max-width:1100px;margin:0 auto;padding:32px 18px;width:100%;flex:1;">

    <div style="text-align:center;max-width:680px;margin:0 auto 24px;">
      <span class="badge badge-primary" style="margin-bottom:8px;">Live Hall Plan</span>
      <h1 style="font-size:clamp(1.6rem,3.2vw,2.2rem);margin-bottom:10px;">Physical Seat Availability</h1>
      <p style="color:var(--text-muted);font-size:14.5px;">
        Accurate 43-seat room layout. Desks 13, 14, 15, 17, and 19 are reserved/locked. Tap any green desk to book.
      </p>
    </div>

    <!-- Quick Stats Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-bottom:20px;">
      <div class="card" style="padding:16px 20px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:#f0fdf4;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:20px;">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <div>
          <div style="font-size:22px;font-weight:800;color:#15803d;"><%= availableCount %></div>
          <div style="font-size:12.5px;color:var(--text-muted);">Available to Book</div>
        </div>
      </div>

      <div class="card" style="padding:16px 20px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:#fef2f2;color:#dc2626;display:flex;align-items:center;justify-content:center;font-size:20px;">
          <i class="fa-solid fa-user-check"></i>
        </div>
        <div>
          <% const occupiedCount = seats.filter(s => s.status === 'occupied').length; %>
          <div style="font-size:22px;font-weight:800;color:#b91c1c;"><%= occupiedCount %></div>
          <div style="font-size:12.5px;color:var(--text-muted);">Occupied / Booked</div>
        </div>
      </div>

      <div class="card" style="padding:16px 20px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:#f1f5f9;color:#64748b;display:flex;align-items:center;justify-content:center;font-size:20px;">
          <i class="fa-solid fa-lock"></i>
        </div>
        <div>
          <% const lockedCount = seats.filter(s => s.status === 'locked' || s.status === 'maintenance').length; %>
          <div style="font-size:22px;font-weight:800;color:#475569;"><%= lockedCount %></div>
          <div style="font-size:12.5px;color:var(--text-muted);">Locked / Unavailable</div>
        </div>
      </div>

      <div class="card" style="padding:16px 20px;display:flex;align-items:center;gap:14px;">
        <div style="width:44px;height:44px;border-radius:10px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:20px;">
          <i class="fa-solid fa-chair"></i>
        </div>
        <div>
          <div style="font-size:22px;font-weight:800;color:#1d4ed8;">43</div>
          <div style="font-size:12.5px;color:var(--text-muted);">Total Physical Seats</div>
        </div>
      </div>
    </div>

    <!-- Legend -->
    <div class="hall-legend-bar">
      <div class="legend-badge-item">
        <span class="legend-color-box available"></span>
        <span>Available Desk</span>
      </div>
      <div class="legend-badge-item">
        <span class="legend-color-box occupied"></span>
        <span>Occupied / Booked</span>
      </div>
      <div class="legend-badge-item">
        <span class="legend-color-box locked"></span>
        <span>Locked / Unavailable (13, 14, 15, 17, 19)</span>
      </div>
    </div>

    <!-- Seat Dictionary Lookup -->
    <%
      const seatDict = {};
      seats.forEach(s => {
        seatDict[s.seatNumber] = s;
      });

      function renderSeat(num) {
        const s = seatDict[String(num)] || { seatNumber: String(num), status: 'available' };
        let statusClass = s.status;
        let statusLabel = 'Open';
        let statusIcon = 'fa-solid fa-chair';

        if (s.status === 'occupied') {
          statusLabel = 'Booked';
          statusIcon = 'fa-solid fa-user';
        } else if (s.status === 'locked' || s.status === 'maintenance') {
          statusClass = 'locked';
          statusLabel = 'Locked';
          statusIcon = 'fa-solid fa-lock';
        }
    %>
      <button 
        type="button"
        class="seat-unit <%= statusClass %>"
        data-seat="<%= s.seatNumber %>"
        data-status="<%= s.status %>"
        title="Seat <%= s.seatNumber %> (<%= statusLabel %>)"
        onclick="handleSeatClick('<%= s.seatNumber %>', '<%= s.status %>')"
        aria-label="Seat <%= s.seatNumber %>, <%= statusLabel %>"
      >
        <span class="seat-number-text"><%= s.seatNumber %></span>
        <span class="seat-status-sub"><i class="<%= statusIcon %>" style="font-size:8px;"></i> <%= statusLabel %></span>
      </button>
    <% } %>

    <!-- Blueprint Hall Container -->
    <div class="hall-blueprint-wrapper">
      <div class="hall-blueprint-header">
        <div class="hall-blueprint-title">
          <i class="fa-solid fa-compass-drafting" style="color:var(--primary);"></i>
          <span>Official Hall Floor Plan (43 Desks)</span>
        </div>
        <span class="hall-scroll-hint"><i class="fa-solid fa-arrows-left-right"></i> Scroll horizontally to view all seats</span>
      </div>

      <div class="hall-scroll-container">
        <div class="hall-floorplan">
          
          <div class="hall-wall-label hall-wall-top">↑ Front of Hall / Whiteboard Wall ↑</div>

          <div class="hall-grid-layout">
            
            <!-- Left Wall Column (Seats 43 down to 31) -->
            <div class="left-wall-column">
              <div class="left-wall-header">Left Wall</div>
              <% const leftWallSeats = [43, 42, 41, 40, 39, 38, 37, 36, 35, 34, 33, 32, 31]; %>
              <% leftWallSeats.forEach(num => { %>
                <% renderSeat(num); %>
              <% }); %>
            </div>

            <!-- Central Aisle / Walkway -->
            <div class="central-aisle">
              <span class="aisle-text">Aisle / Walkway</span>
              <span class="aisle-text">Aisle / Walkway</span>
            </div>

            <!-- Right Hall Blocks -->
            <div class="right-hall-content">
              
              <!-- Block 1 (Top Block: 4 3 2 1 & 5 6 7 8) -->
              <div class="hall-block-card">
                <div class="hall-block-header">
                  <span>Block 1 (Front Hall)</span>
                  <span style="font-size:10px;color:#94a3b8;">Desks 1 – 8</span>
                </div>
                <div class="hall-row-grid cols-4">
                  <% [4, 3, 2, 1].forEach(num => renderSeat(num)); %>
                </div>
                <div class="hall-row-subgap"></div>
                <div class="hall-row-grid cols-4">
                  <% [5, 6, 7, 8].forEach(num => renderSeat(num)); %>
                </div>
              </div>

              <!-- Block 2 (Mid Block: 12 11 10 9 & 13 14 15 16) -->
              <div class="hall-block-card">
                <div class="hall-block-header">
                  <span>Block 2 (Mid Hall)</span>
                  <span style="font-size:10px;color:#94a3b8;">Desks 9 – 16</span>
                </div>
                <div class="hall-row-grid cols-4">
                  <% [12, 11, 10, 9].forEach(num => renderSeat(num)); %>
                </div>
                <div class="hall-row-subgap"></div>
                <div class="hall-row-grid cols-4">
                  <% [13, 14, 15, 16].forEach(num => renderSeat(num)); %>
                </div>
              </div>

              <!-- Door / Hall Entrance Position (Right Edge) -->
              <div class="hall-door-zone">
                <div class="hall-door-badge">
                  <i class="fa-solid fa-door-open"></i> MAIN ENTRANCE / DOOR ➔
                </div>
              </div>

              <!-- Block 3 (Opposite Door: 19 18 17 & 20 21 22) - 3 Columns wide -->
              <div class="hall-block-card">
                <div class="hall-block-header">
                  <span>Block 3 (Opposite Door)</span>
                  <span style="font-size:10px;color:#94a3b8;">Desks 17 – 22</span>
                </div>
                <div class="hall-row-grid cols-3">
                  <% [19, 18, 17].forEach(num => renderSeat(num)); %>
                </div>
                <div class="hall-row-subgap"></div>
                <div class="hall-row-grid cols-3">
                  <% [20, 21, 22].forEach(num => renderSeat(num)); %>
                </div>
              </div>

              <!-- Block 4 (Bottom Block: 26 25 24 23 & 27 28 29 30) -->
              <div class="hall-block-card">
                <div class="hall-block-header">
                  <span>Block 4 (Back Hall)</span>
                  <span style="font-size:10px;color:#94a3b8;">Desks 23 – 30</span>
                </div>
                <div class="hall-row-grid cols-4">
                  <% [26, 25, 24, 23].forEach(num => renderSeat(num)); %>
                </div>
                <div class="hall-row-subgap"></div>
                <div class="hall-row-grid cols-4">
                  <% [27, 28, 29, 30].forEach(num => renderSeat(num)); %>
                </div>
              </div>

            </div>

          </div>

          <div class="hall-wall-label hall-wall-bottom">↓ Back Wall / Quiet Zone ↓</div>

        </div>
      </div>
    </div>

    <!-- Call to action card -->
    <div class="card" style="text-align:center;padding:32px 20px;background:linear-gradient(135deg,#f8fafc 0%,#edf2f7 100%);border:1px solid var(--border);">
      <h3 style="margin-bottom:8px;font-size:20px;">Ready to Book Your Study Seat?</h3>
      <p style="color:var(--text-muted);font-size:14.5px;max-width:540px;margin:0 auto 20px;">
        Log in to your student account to select your seat, pick your study slot, and receive instant confirmation.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="/student/login" class="btn btn-primary btn-lg">
          <i class="fa-solid fa-user-graduate"></i> Log In to Book
        </a>
        <a href="/student/register" class="btn btn-outline btn-lg">
          <i class="fa-solid fa-user-plus"></i> Create Student Account
        </a>
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer style="background:#0f172a;color:#94a3b8;padding:24px 20px;text-align:center;font-size:13px;margin-top:auto;">
    <span>© <%= currentYear %> <%= libraryName %> • Shahdol, M.P. • Call: +91 8103485288</span>
  </footer>

  <script>
    function handleSeatClick(seatNumber, status) {
      if (status === 'available') {
        const choice = confirm(`Seat ${seatNumber} is currently AVAILABLE!\n\nWould you like to log in to book Seat ${seatNumber} now?`);
        if (choice) {
          window.location.href = '/student/login';
        }
      } else if (status === 'locked' || status === 'maintenance') {
        alert(`Seat ${seatNumber} is marked LOCKED / UNAVAILABLE.\n\nPlease choose an available green desk.`);
      } else {
        alert(`Seat ${seatNumber} is currently OCCUPIED / BOOKED by another student.`);
      }
    }
  </script>
</body>
</html>
