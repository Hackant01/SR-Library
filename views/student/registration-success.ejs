<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <style>
    .status-badge-pending {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #fff8e1;
      color: #b78103;
      border: 1px solid #ffe082;
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 13px;
    }
    .status-badge-paid {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #e8f5e9;
      color: #2e7d32;
      border: 1px solid #c8e6c9;
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 13px;
    }
    .id-display-box {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      color: #fff;
      border-radius: 12px;
      padding: 20px;
      margin: 20px 0;
      box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    }
    .id-tag {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 4px;
    }
    .id-number {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 3px;
      color: #38bdf8;
      font-family: monospace;
    }
    .workflow-timeline {
      display: flex;
      flex-direction: column;
      gap: 12px;
      text-align: left;
      margin: 20px 0;
    }
    .workflow-step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 14px;
      line-height: 1.5;
    }
    .step-icon {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
      font-weight: 700;
    }
    .step-done {
      background: #e8f5e9;
      color: #2e7d32;
    }
    .step-current {
      background: #fff8e1;
      color: #f59e0b;
      animation: pulse 2s infinite;
    }
    .step-future {
      background: #f1f5f9;
      color: #94a3b8;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
  </style>
</head>
<body>
<div class="success-page" style="padding:40px 16px;">
  <div class="success-card" style="max-width:580px;">
    <% const isOnline = student && student.paymentMethod === 'online' && student.paymentStatus === 'paid'; %>

    <div class="success-icon" style="font-size:48px;margin-bottom:12px;">
      <%= isOnline ? '🎉' : '⏳' %>
    </div>

    <h1 style="font-size:clamp(1.4rem,3vw,1.8rem);margin-bottom:8px;color:#1e293b;">
      <%= isOnline ? 'Online Payment Verified & Account Active!' : 'Registration Submitted — Cash Payment Pending' %>
    </h1>

    <p style="color:var(--text-muted);font-size:15px;line-height:1.6;margin-bottom:20px;">
      <% if (isOnline) { %>
        Welcome<% if (student && student.name) { %>, <strong><%= student.name %></strong><% } %>! Your ₹150 online payment was verified. Your account is <strong>active</strong> and you can log in immediately.
      <% } else { %>
        Welcome<% if (student && student.name) { %>, <strong><%= student.name %></strong><% } %>! Your registration has been submitted with <strong>Cash Payment</strong>. Please pay ₹150 in cash at the SR Library counter to activate your account.
      <% } %>
    </p>

    <!-- Student ID Display Card -->
    <div class="id-display-box">
      <div class="id-tag"><%= isOnline ? 'Your Active Student ID' : 'Your Generated Student ID (Pending Activation)' %></div>
      <div class="id-number"><%= (student && student.studentId) || 'LIB20260001' %></div>
      <div style="font-size:12px;color:#cbd5e1;margin-top:6px;">
        <%= isOnline ? 'Use this Student ID & your registered email to log in' : 'Present this ID at the library counter while paying ₹150 cash' %>
      </div>
    </div>

    <!-- Status Badges -->
    <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;">
      <% if (isOnline) { %>
        <span class="status-badge-paid">
          ✓ Payment Method: Online
        </span>
        <span class="status-badge-paid">
          ✓ ₹150 Paid
        </span>
        <span class="status-badge-paid" style="background:#e0f2fe;color:#0369a1;border-color:#bae6fd;">
          ✓ Account Active
        </span>
      <% } else { %>
        <span class="status-badge-pending" style="background:#f1f5f9;color:#475569;border-color:#cbd5e1;">
          💵 Method: Cash
        </span>
        <span class="status-badge-pending">
          ⏳ Payment: Pending ₹150
        </span>
        <span class="status-badge-pending">
          ⏳ Account: Pending Verification
        </span>
      <% } %>
    </div>

    <!-- Workflow Progress -->
    <div style="background:var(--surface-2, #f8fafc);border:1px solid var(--border, #e2e8f0);border-radius:12px;padding:20px;margin-bottom:24px;">
      <div style="font-weight:700;font-size:14px;color:#1e293b;margin-bottom:14px;text-align:left;">
        <%= isOnline ? 'Verification Completed:' : 'Next Steps to Activate Account:' %>
      </div>
      <div class="workflow-timeline">
        <div class="workflow-step">
          <div class="step-icon step-done">✓</div>
          <div>
            <strong>Step 1: Student Details Submitted</strong>
            <div style="color:var(--text-muted);font-size:13px;">Personal and academic details saved</div>
          </div>
        </div>

        <% if (isOnline) { %>
          <div class="workflow-step">
            <div class="step-icon step-done">✓</div>
            <div>
              <strong>Step 2: Online ₹150 Payment Verified</strong>
              <div style="color:var(--text-muted);font-size:13px;">
                Verified on server <% if (student && student.transactionId) { %>(Ref: <%= student.transactionId %>)<% } %>
              </div>
            </div>
          </div>
          <div class="workflow-step">
            <div class="step-icon step-done">✓</div>
            <div>
              <strong>Step 3: Automatically Approved & Active</strong>
              <div style="color:var(--text-muted);font-size:13px;">No manual approval needed for online payments!</div>
            </div>
          </div>
          <div class="workflow-step">
            <div class="step-icon step-done">📧</div>
            <div>
              <strong>Step 4: Email Sent with Login Credentials</strong>
              <div style="color:var(--text-muted);font-size:13px;">Confirmation sent to <strong><%= (student && student.email) || 'your email' %></strong></div>
            </div>
          </div>
        <% } else { %>
          <div class="workflow-step">
            <div class="step-icon step-current">💵</div>
            <div>
              <strong>Step 2: Pay ₹150 Cash at SR Library Counter (Action Required)</strong>
              <div style="color:var(--text-muted);font-size:13px;">Visit the reception desk and hand over ₹150 cash</div>
            </div>
          </div>
          <div class="workflow-step">
            <div class="step-icon step-future">🛡️</div>
            <div>
              <strong>Step 3: Admin Verifies Cash Payment</strong>
              <div style="color:var(--text-muted);font-size:13px;">Librarian clicks "Mark Cash Payment Received" in Admin Panel</div>
            </div>
          </div>
          <div class="workflow-step">
            <div class="step-icon step-future">📧</div>
            <div>
              <strong>Step 4: Account Activated & Email Sent</strong>
              <div style="color:var(--text-muted);font-size:13px;">Your account becomes active and activation email will be sent to <strong><%= (student && student.email) || 'your email' %></strong></div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Action buttons -->
    <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
      <% if (isOnline) { %>
        <a href="/student/login" class="btn btn-primary" id="go-to-login" style="padding:14px 28px;font-weight:700;">
          🚀 Login to Student Portal →
        </a>
      <% } else { %>
        <a href="/student/login" class="btn btn-primary" id="go-to-login" style="padding:12px 24px;">
          🔑 Check Login Status
        </a>
      <% } %>
      <a href="/" class="btn btn-ghost" id="go-home" style="padding:12px 24px;">
        🏠 Back to Home
      </a>
    </div>

    <p style="margin-top:24px;font-size:13px;color:var(--text-muted);line-height:1.6;">
      <% if (isOnline) { %>
        You can now log in anytime using your registered email and password.
      <% } else { %>
        Please note: Cash registrations cannot log in until the administrator verifies the ₹150 cash payment.
      <% } %>
    </p>
  </div>
</div>
</body>
</html>
