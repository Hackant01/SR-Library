<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %></title>
  <link rel="icon" href="/images/logo.jpg" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/seating.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    .mobile-booking-bar {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #ffffff;
      border-top: 1px solid var(--border);
      padding: 12px 18px;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
      z-index: 1000;
      align-items: center;
      justify-content: space-between;
    }
    @media (max-width: 900px) {
      .mobile-booking-bar {
        display: flex;
      }
      body {
        padding-bottom: 74px !important;
      }
    }
    .success-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.7);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 16px;
    }
    .success-modal-backdrop.active {
      display: flex;
    }
  </style>
</head>
<body style="background:var(--bg);min-height:100vh;">

  <!-- Floating WhatsApp Contact Button -->
  <a href="https://wa.me/918103485288" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat with SR Library on WhatsApp" title="WhatsApp Us">
    <i class="fa-brands fa-whatsapp"></i>
  </a>

  <!-- Topbar -->
  <header style="background:#ffffff;height:64px;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:1000;">
    <div style="max-width:1160px;margin:0 auto;padding:0 18px;height:100%;display:flex;align-items:center;justify-content:space-between;">
      <a href="/student/dashboard" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--text-primary);font-weight:600;font-size:14px;">
        <i class="fa-solid fa-arrow-left"></i> <span>Dashboard</span>
      </a>

      <div style="font-family:var(--font-display);font-weight:700;font-size:16px;color:var(--primary-dark);display:flex;align-items:center;gap:8px;">
        <i class="fa-solid fa-chair" style="color:var(--primary);"></i>
        <span>43-Seat Reservation</span>
      </div>

      <div style="font-size:13px;color:var(--text-muted);">
        <i class="fa-solid fa-user-graduate"></i> <%= student.fullName ? student.fullName.split(' ')[0] : 'Student' %>
      </div>
    </div>
  </header>

  <!-- Page Content -->
  <main style="max-width:1160px;margin:0 auto;padding:24px 16px;width:100%;">

    <!-- Header Instructions -->
    <div style="text-align:center;max-width:640px;margin:0 auto 20px;">
      <h1 style="font-size:clamp(1.5rem,3vw,1.9rem);margin-bottom:6px;font-weight:800;">Choose Your Physical Study Desk</h1>
      <p style="color:var(--text-muted);font-size:14px;">
        Tap on any green available desk to select it. Desks 13, 14, 15, 17, and 19 are reserved/locked.
      </p>
    </div>

    <!-- Active Booking Notice (if already booked) -->
    <% if (activeBooking) { %>
      <div class="alert alert-warning" style="margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;border-radius:12px;background:#fffbeb;border:1px solid #fef3c7;padding:12px 16px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <span style="font-size:20px;color:#d97706;"><i class="fa-solid fa-circle-info"></i></span>
          <div style="font-size:13.5px;color:#92400e;">
            You currently hold <strong>Seat <%= activeBooking.seatNumber %></strong>. Choosing another seat will reassign your active booking.
          </div>
        </div>
        <a href="/student/dashboard" class="btn btn-sm btn-ghost" style="border:1px solid rgba(0,0,0,0.15);font-size:12.5px;">Keep Current Seat</a>
      </div>
    <% } %>

    <!-- Date & Slot Controls -->
    <div class="card" style="padding:16px 20px;margin-bottom:20px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;align-items:center;">
        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;color:var(--text-secondary);margin-bottom:6px;">
            <i class="fa-regular fa-calendar"></i> Booking Date
          </label>
          <input type="date" id="bookingDateInput" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" min="<%= new Date().toISOString().split('T')[0] %>" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;color:var(--text-secondary);margin-bottom:6px;">
            <i class="fa-regular fa-clock"></i> Study Shift / Slot
          </label>
          <select id="slotSelect" class="form-control" style="width:100%;padding:10px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;background:#fff;">
            <option value="Full Day (6:00 AM - 11:00 PM)" selected>Full Day (6:00 AM – 11:00 PM)</option>
            <option value="Morning Shift (6:00 AM - 2:00 PM)">Morning Shift (6:00 AM – 2:00 PM)</option>
            <option value="Evening Shift (2:00 PM - 10:00 PM)">Evening Shift (2:00 PM – 10:00 PM)</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;color:var(--text-secondary);margin-bottom:6px;">
            <i class="fa-solid fa-shield-halved"></i> Hall Atmosphere
          </label>
          <div style="font-size:13.5px;font-weight:600;color:var(--primary);padding:10px 0;">
            100% Quiet Zone • AC • WiFi 6
          </div>
        </div>
      </div>
    </div>

    <!-- Seat Legend -->
    <div class="hall-legend-bar">
      <div class="legend-badge-item">
        <span class="legend-color-box available"></span>
        <span>Available to Book</span>
      </div>
      <div class="legend-badge-item">
        <span class="legend-color-box selected"></span>
        <span>Your Selected Seat</span>
      </div>
      <div class="legend-badge-item">
        <span class="legend-color-box occupied"></span>
        <span>Occupied / Booked</span>
      </div>
      <div class="legend-badge-item">
        <span class="legend-color-box locked"></span>
        <span>Locked / Unavailable (13, 14, 15, 17, 19)</span>
      </div>
    </div>

    <!-- Seat Dictionary Lookup -->
    <%
      const seatDict = {};
      seats.forEach(s => {
        seatDict[s.seatNumber] = s;
      });

      function renderSelectableSeat(num) {
        const s = seatDict[String(num)] || { seatNumber: String(num), status: 'available', section: 'Study Hall' };
        let isCurrent = activeBooking && activeBooking.seatNumber === s.seatNumber;
        let statusClass = s.status;
        let statusLabel = 'Available';
        let statusIcon = 'fa-solid fa-chair';

        if (isCurrent) {
          statusClass = 'selected';
          statusLabel = 'Your Seat';
          statusIcon = 'fa-solid fa-check';
        } else if (s.status === 'occupied') {
          statusLabel = 'Booked';
          statusIcon = 'fa-solid fa-user';
        } else if (s.status === 'locked' || s.status === 'maintenance') {
          statusClass = 'locked';
          statusLabel = 'Locked';
          statusIcon = 'fa-solid fa-lock';
        }
    %>
      <button 
        type="button"
        class="seat-unit <%= statusClass %>"
        data-seat="<%= s.seatNumber %>"
        data-status="<%= s.status %>"
        data-section="<%= s.section || 'Hall' %>"
        data-current="<%= isCurrent ? 'true' : 'false' %>"
        title="Seat <%= s.seatNumber %> (<%= statusLabel %>)"
        onclick="selectSeat(this)"
        aria-label="Seat <%= s.seatNumber %>, <%= statusLabel %>"
      >
        <span class="seat-number-text"><%= s.seatNumber %></span>
        <span class="seat-status-sub"><i class="<%= statusIcon %>" style="font-size:8px;"></i> <%= statusLabel %></span>
      </button>
    <% } %>

    <!-- Layout: Left Grid / Right Confirmation Card on Desktop -->
    <div style="display:grid;grid-template-columns:1fr 310px;gap:20px;align-items:start;" id="bookingLayoutGrid">

      <!-- Left Column: 43-Seat Blueprint -->
      <div>
        <div class="hall-blueprint-wrapper">
          <div class="hall-blueprint-header">
            <div class="hall-blueprint-title">
              <i class="fa-solid fa-compass-drafting" style="color:var(--primary);"></i>
              <span>Interactive 43-Seat Seating Arrangement</span>
            </div>
            <span class="hall-scroll-hint"><i class="fa-solid fa-arrows-left-right"></i> Swipe to explore hall</span>
          </div>

          <div class="hall-scroll-container">
            <div class="hall-floorplan">
              
              <div class="hall-wall-label hall-wall-top">↑ Front of Hall / Whiteboard Wall ↑</div>

              <div class="hall-grid-layout">
                
                <!-- Left Wall Column (Seats 43 down to 31) -->
                <div class="left-wall-column">
                  <div class="left-wall-header">Left Wall</div>
                  <% const leftWallSeats = [43, 42, 41, 40, 39, 38, 37, 36, 35, 34, 33, 32, 31]; %>
                  <% leftWallSeats.forEach(num => renderSelectableSeat(num)); %>
                </div>

                <!-- Central Aisle / Walkway -->
                <div class="central-aisle">
                  <span class="aisle-text">Aisle / Walkway</span>
                  <span class="aisle-text">Aisle / Walkway</span>
                </div>

                <!-- Right Hall Blocks -->
                <div class="right-hall-content">
                  
                  <!-- Block 1 (Top Block: 4 3 2 1 & 5 6 7 8) -->
                  <div class="hall-block-card">
                    <div class="hall-block-header">
                      <span>Block 1 (Front Hall)</span>
                      <span style="font-size:10px;color:#94a3b8;">Desks 1 – 8</span>
                    </div>
                    <div class="hall-row-grid cols-4">
                      <% [4, 3, 2, 1].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                    <div class="hall-row-subgap"></div>
                    <div class="hall-row-grid cols-4">
                      <% [5, 6, 7, 8].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                  </div>

                  <!-- Block 2 (Mid Block: 12 11 10 9 & 13 14 15 16) -->
                  <div class="hall-block-card">
                    <div class="hall-block-header">
                      <span>Block 2 (Mid Hall)</span>
                      <span style="font-size:10px;color:#94a3b8;">Desks 9 – 16</span>
                    </div>
                    <div class="hall-row-grid cols-4">
                      <% [12, 11, 10, 9].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                    <div class="hall-row-subgap"></div>
                    <div class="hall-row-grid cols-4">
                      <% [13, 14, 15, 16].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                  </div>

                  <!-- Door / Hall Entrance Position (Right Edge) -->
                  <div class="hall-door-zone">
                    <div class="hall-door-badge">
                      <i class="fa-solid fa-door-open"></i> MAIN ENTRANCE / DOOR ➔
                    </div>
                  </div>

                  <!-- Block 3 (Opposite Door: 19 18 17 & 20 21 22) - 3 Columns wide -->
                  <div class="hall-block-card">
                    <div class="hall-block-header">
                      <span>Block 3 (Opposite Door)</span>
                      <span style="font-size:10px;color:#94a3b8;">Desks 17 – 22</span>
                    </div>
                    <div class="hall-row-grid cols-3">
                      <% [19, 18, 17].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                    <div class="hall-row-subgap"></div>
                    <div class="hall-row-grid cols-3">
                      <% [20, 21, 22].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                  </div>

                  <!-- Block 4 (Bottom Block: 26 25 24 23 & 27 28 29 30) -->
                  <div class="hall-block-card">
                    <div class="hall-block-header">
                      <span>Block 4 (Back Hall)</span>
                      <span style="font-size:10px;color:#94a3b8;">Desks 23 – 30</span>
                    </div>
                    <div class="hall-row-grid cols-4">
                      <% [26, 25, 24, 23].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                    <div class="hall-row-subgap"></div>
                    <div class="hall-row-grid cols-4">
                      <% [27, 28, 29, 30].forEach(num => renderSelectableSeat(num)); %>
                    </div>
                  </div>

                </div>

              </div>

              <div class="hall-wall-label hall-wall-bottom">↓ Back Wall / Quiet Zone ↓</div>

            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Booking Summary Card (Desktop) -->
      <div class="card" style="position:sticky;top:84px;padding:22px;border:2px solid var(--primary-light);">
        <h3 style="font-size:16px;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
          <i class="fa-solid fa-clipboard-check" style="color:var(--primary);"></i>
          <span>Booking Summary</span>
        </h3>

        <div style="background:#f8fafc;border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:18px;">
          <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;">Selected Desk</div>
          <div id="desktopSelectedSeat" style="font-size:26px;font-weight:800;color:var(--primary);margin-top:2px;font-family:var(--font-display);">
            <%= activeBooking ? `Seat ${activeBooking.seatNumber}` : 'Tap a Desk' %>
          </div>
          <div id="desktopSelectedSection" style="font-size:12.5px;color:var(--text-secondary);margin-top:2px;">
            <%= activeBooking ? 'Current Active Seat' : 'Tap any green available desk on the map' %>
          </div>
        </div>

        <div style="font-size:13px;display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
          <div style="display:flex;justify-content:space-between;">
            <span style="color:var(--text-muted);">Student:</span>
            <strong><%= student.fullName %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:var(--text-muted);">Student ID:</span>
            <span style="font-family:monospace;font-weight:600;"><%= student.studentId || 'Verified' %></span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:var(--text-muted);">Date:</span>
            <strong id="desktopDateText"><%= new Date().toLocaleDateString('en-IN', {day:'2-digit',month:'short'}) %></strong>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:var(--text-muted);">Slot:</span>
            <span id="desktopSlotText">Full Day</span>
          </div>
          <div style="display:flex;justify-content:space-between;">
            <span style="color:var(--text-muted);">Status:</span>
            <span class="badge badge-success" style="font-size:11px;">Included in Membership</span>
          </div>
        </div>

        <button 
          type="button" 
          id="confirmBookingBtn" 
          onclick="confirmBooking()" 
          class="btn btn-primary btn-lg btn-block"
          style="width:100%;justify-content:center;font-weight:700;"
          <%= !activeBooking ? 'disabled' : '' %>
        >
          <i class="fa-solid fa-check"></i> Confirm Reservation
        </button>

        <p style="font-size:11.5px;color:var(--text-muted);text-align:center;margin-top:10px;line-height:1.4;">
          Your seat will be reserved immediately upon confirmation.
        </p>
      </div>

    </div>

  </main>

  <!-- Sticky Mobile Booking Bar -->
  <div class="mobile-booking-bar" id="mobileBookingBar">
    <div>
      <div style="font-size:11.5px;color:var(--text-muted);font-weight:600;text-transform:uppercase;">Selected Desk</div>
      <div id="mobileSeatText" style="font-size:18px;font-weight:800;color:var(--primary);line-height:1.2;">
        <%= activeBooking ? `Seat ${activeBooking.seatNumber}` : 'Tap a Desk' %>
      </div>
    </div>
    <button 
      type="button" 
      id="mobileConfirmBtn" 
      onclick="confirmBooking()" 
      class="btn btn-primary btn-sm"
      style="padding:10px 18px;font-weight:700;display:flex;align-items:center;gap:6px;"
      <%= !activeBooking ? 'disabled' : '' %>
    >
      <i class="fa-solid fa-check"></i> Confirm
    </button>
  </div>

  <!-- Success Modal -->
  <div class="success-modal-backdrop" id="successModal">
    <div style="background:#ffffff;border-radius:20px;max-width:400px;width:100%;padding:28px 24px;text-align:center;box-shadow:var(--shadow-xl);border:1px solid var(--border);">
      <div style="width:64px;height:64px;border-radius:50%;background:#dcfce7;color:#16a34a;font-size:32px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <i class="fa-solid fa-check"></i>
      </div>
      <h2 style="font-size:20px;font-weight:800;margin-bottom:6px;">Booking Confirmed!</h2>
      <p style="font-size:13.5px;color:var(--text-muted);margin-bottom:20px;">
        Your study desk has been successfully reserved.
      </p>

      <div style="background:#f8fafc;border:1px solid var(--border);border-radius:12px;padding:16px;text-align:left;font-size:13.5px;margin-bottom:22px;display:flex;flex-direction:column;gap:8px;">
        <div style="display:flex;justify-content:space-between;">
          <span style="color:var(--text-muted);">Seat:</span>
          <strong id="modalSeatNum" style="color:var(--primary);font-size:16px;">--</strong>
        </div>
        <div style="display:flex;justify-content:space-between;">
          <span style="color:var(--text-muted);">Booking ID:</span>
          <strong id="modalBookingId" style="font-family:monospace;">--</strong>
        </div>
        <div style="display:flex;justify-content:space-between;">
          <span style="color:var(--text-muted);">Status:</span>
          <span class="badge badge-success">✓ Active Reservation</span>
        </div>
      </div>

      <a href="/student/dashboard" class="btn btn-primary btn-block" style="width:100%;padding:12px;justify-content:center;font-weight:700;">
        <i class="fa-solid fa-gauge-high"></i> Go to Dashboard
      </a>
    </div>
  </div>

  <script>
    let selectedSeatNumber = '<%= activeBooking ? activeBooking.seatNumber : "" %>';

    function selectSeat(element) {
      const status = element.dataset.status;
      const seat = element.dataset.seat;
      const section = element.dataset.section || 'Hall';

      if (status === 'locked' || status === 'maintenance') {
        alert(`Seat ${seat} is LOCKED / UNAVAILABLE and cannot be selected.\nPlease choose an available green desk.`);
        return;
      }

      if (status === 'occupied' && seat !== '<%= activeBooking ? activeBooking.seatNumber : "" %>') {
        alert(`Seat ${seat} is currently BOOKED by another student.\nPlease choose an available green desk.`);
        return;
      }

      // Remove selected class from all other selectable units
      document.querySelectorAll('.seat-unit').forEach(el => {
        if (el.dataset.current !== 'true') {
          el.classList.remove('selected');
        }
      });

      // Mark this element as selected
      element.classList.add('selected');
      selectedSeatNumber = seat;

      // Update desktop summary
      document.getElementById('desktopSelectedSeat').textContent = `Seat ${seat}`;
      document.getElementById('desktopSelectedSection').textContent = `${section} • Ready to confirm`;
      document.getElementById('confirmBookingBtn').disabled = false;

      // Update mobile bar
      document.getElementById('mobileSeatText').textContent = `Seat ${seat}`;
      document.getElementById('mobileConfirmBtn').disabled = false;
    }

    async function confirmBooking() {
      if (!selectedSeatNumber) {
        alert('Please tap on an available seat first.');
        return;
      }

      const date = document.getElementById('bookingDateInput').value;
      const slot = document.getElementById('slotSelect').value;
      const btn = document.getElementById('confirmBookingBtn');
      const mobileBtn = document.getElementById('mobileConfirmBtn');

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Reserving...';
      if (mobileBtn) {
        mobileBtn.disabled = true;
        mobileBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ...';
      }

      try {
        const res = await fetch('/student/book-seat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            seatNumber: selectedSeatNumber,
            date,
            slot
          })
        });

        const data = await res.json();
        if (data.success) {
          document.getElementById('modalSeatNum').textContent = `Seat ${data.seatNumber}`;
          document.getElementById('modalBookingId').textContent = data.bookingId;
          document.getElementById('successModal').classList.add('active');
        } else {
          alert(data.message || 'Booking failed.');
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm Reservation';
          if (mobileBtn) {
            mobileBtn.disabled = false;
            mobileBtn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm';
          }
        }
      } catch (err) {
        alert('Error reserving seat: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm Reservation';
        if (mobileBtn) {
          mobileBtn.disabled = false;
          mobileBtn.innerHTML = '<i class="fa-solid fa-check"></i> Confirm';
        }
      }
    }

    // Sync input date and slot text
    document.getElementById('bookingDateInput')?.addEventListener('change', (e) => {
      const dt = new Date(e.target.value);
      document.getElementById('desktopDateText').textContent = dt.toLocaleDateString('en-IN', {day:'2-digit',month:'short'});
    });
    document.getElementById('slotSelect')?.addEventListener('change', (e) => {
      document.getElementById('desktopSlotText').textContent = e.target.value.split(' ')[0] + ' ' + (e.target.value.split(' ')[1] || '');
    });
  </script>
</body>
</html>
