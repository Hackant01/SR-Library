<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>
<body>
<!-- Student Navbar -->
<nav style="background:var(--primary);height:60px;display:flex;align-items:center;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,0.2);">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;width:100%;display:flex;align-items:center;justify-content:space-between;">
    <a href="/student/dashboard" style="color:#fff;font-family:var(--font-display);font-size:18px;font-weight:700;">📚 <%= libraryName %></a>
    <div style="display:flex;align-items:center;gap:12px;">
      <span style="color:rgba(255,255,255,0.7);font-size:14px;">Welcome, <%= student.fullName.split(' ')[0] %></span>
      <form action="/student/logout" method="POST" style="margin:0;">
        <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.2);" id="logout-btn">Logout</button>
      </form>
    </div>
  </div>
</nav>

<div class="student-dash">
  <!-- Dashboard Header -->
  <div class="student-dash-header">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:flex;align-items:center;gap:20px;">
        <div class="avatar-circle" style="width:64px;height:64px;font-size:24px;">
          <%= student.fullName.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h1 style="color:#fff;font-size:clamp(1.2rem,2.5vw,1.7rem);margin-bottom:4px;"><%= student.fullName %></h1>
          <p style="color:rgba(255,255,255,0.7);font-size:14px;"><%= student.email %></p>
        </div>
        <div style="margin-left:auto;">
          <% if (student.accountStatus === 'active') { %>
            <span class="badge badge-success" style="font-size:13px;padding:6px 16px;">✓ Active</span>
          <% } else if (student.accountStatus === 'pending') { %>
            <span class="badge badge-warning" style="font-size:13px;padding:6px 16px;">⏳ Pending ID</span>
          <% } else { %>
            <span class="badge badge-danger" style="font-size:13px;padding:6px 16px;">✗ Inactive</span>
          <% } %>
        </div>
      </div>

      <!-- Info Grid -->
      <div class="student-info-grid" style="margin-top:20px;max-width:700px;">
        <div class="student-info-item">
          <div class="student-info-label">Student ID</div>
          <div class="student-info-value">
            <% if (student.studentId) { %>
              <%= student.studentId %>
            <% } else { %>
              <span style="color:rgba(255,255,255,0.5);font-style:italic;">Pending Admin Approval</span>
            <% } %>
          </div>
        </div>
        <div class="student-info-item">
          <div class="student-info-label">Joining Date</div>
          <div class="student-info-value"><%= new Date(student.joiningDate).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></div>
        </div>
        <div class="student-info-item">
          <div class="student-info-label">Payment Status</div>
          <div class="student-info-value" style="color:<%= student.paymentStatus === 'paid' ? '#a5d6a7' : '#ef9a9a' %>;">
            <%= student.paymentStatus === 'paid' ? '✓ ₹150 Paid' : '⚠ Pending' %>
          </div>
        </div>
        <div class="student-info-item">
          <div class="student-info-label">Registration Date</div>
          <div class="student-info-value"><%= new Date(student.registrationDate).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Content -->
  <div style="max-width:1200px;margin:0 auto;padding:28px 24px;">

    <% if (!student.studentId) { %>
    <div class="alert alert-warning mb-24">
      <span style="font-size:22px;">⏳</span>
      <div>
        <strong>Student ID Pending</strong><br/>
        <span style="font-size:14px;">Your registration is pending admin approval. Your Student ID will be assigned within 24–48 hours and sent to your email: <strong><%= student.email %></strong></span>
      </div>
    </div>
    <% } %>

    <% if (student.studentId) { %>
    <div class="alert alert-success mb-24">
      <span style="font-size:22px;">🎉</span>
      <div>
        <strong>Registration Complete!</strong><br/>
        <span style="font-size:14px;">Your Student ID is <strong><%= student.studentId %></strong>. You can now access all library services.</span>
      </div>
    </div>
    <% } %>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start;">
      <!-- Profile Card -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">👤 My Profile</div>
          <a href="/student/profile" class="btn btn-ghost btn-sm">View Full Profile</a>
        </div>
        <div class="card-body">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Full Name</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.fullName %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Parent's Name</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.parentName %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Mobile</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.mobile %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Gender</div>
              <div style="font-weight:600;margin-top:4px;text-transform:capitalize;"><%= student.gender %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Education</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.educationLevel || student.course || 'Undergraduate' %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Preparing For</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.preparingFor || 'Competitive Exams' %></div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">Membership Slot</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.membershipSlot || 'Full Day' %> (<%= student.slotTiming || '6 AM - 10 PM' %>)</div>
            </div>
            <div>
              <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;">ID Proof</div>
              <div style="font-weight:600;margin-top:4px;"><%= student.idProofType || 'Aadhaar' %>: <%= student.idProofNumber || 'Verified' %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Card -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">💳 Payment</div>
        </div>
        <div class="card-body">
          <% if (payment) { %>
            <div style="text-align:center;margin-bottom:16px;">
              <div style="font-size:36px;font-weight:800;color:var(--success);">₹150</div>
              <span class="badge badge-success">✓ Payment Verified</span>
            </div>
            <div style="font-size:13px;">
              <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);">
                <span style="color:var(--text-muted);">Payment ID</span>
                <span style="font-weight:500;word-break:break-all;text-align:right;max-width:60%;"><%= payment.razorpayPaymentId || 'N/A' %></span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);">
                <span style="color:var(--text-muted);">Date</span>
                <span style="font-weight:500;"><%= new Date(payment.paymentDate).toLocaleDateString('en-IN') %></span>
              </div>
              <div style="display:flex;justify-content:space-between;padding:8px 0;">
                <span style="color:var(--text-muted);">Status</span>
                <span class="badge badge-success">Paid</span>
              </div>
            </div>
          <% } else { %>
            <div style="text-align:center;color:var(--text-muted);font-size:14px;">
              No payment information available.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
</body>
</html>
