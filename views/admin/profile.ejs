<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Profile | <%= libraryName %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
<div class="admin-wrapper">
  <%- include('./partials/sidebar', { currentPage: 'profile' }) %>

  <div class="admin-main">
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" onclick="toggleSidebar()">☰</button>
      <div class="admin-topbar-title">Admin Profile</div>
    </div>

    <div class="admin-content">
      <div class="profile-grid">
        <!-- Avatar Card -->
        <div class="card" style="padding:32px;text-align:center;">
          <div style="width:80px;height:80px;background:linear-gradient(135deg,var(--primary),var(--primary-light));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;color:#fff;font-weight:700;margin:0 auto 16px;">
            <%= admin.name.charAt(0).toUpperCase() %>
          </div>
          <h2 style="font-size:20px;margin-bottom:4px;"><%= admin.name %></h2>
          <p style="color:var(--text-muted);font-size:14px;margin-bottom:12px;"><%= admin.email %></p>
          <span class="badge badge-info" style="padding:6px 16px;font-size:13px;text-transform:capitalize;"><%= admin.role %></span>
          <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
            <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">Last Login</div>
            <div style="font-weight:600;font-size:14px;"><%= admin.lastLogin ? new Date(admin.lastLogin).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) : 'N/A' %></div>
          </div>
        </div>

        <!-- Details Card -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">🔑 Account Information</div>
          </div>
          <div class="card-body">
            <table class="detail-info-table">
              <tr><td>Name</td><td><%= admin.name %></td></tr>
              <tr><td>Email</td><td><%= admin.email %></td></tr>
              <tr><td>Role</td><td style="text-transform:capitalize;"><%= admin.role %></td></tr>
              <tr><td>Account Created</td><td><%= new Date(admin.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></td></tr>
              <tr><td>Last Login</td><td><%= admin.lastLogin ? new Date(admin.lastLogin).toLocaleDateString('en-IN') : 'N/A' %></td></tr>
            </table>

            <div style="margin-top:24px;padding:16px;background:var(--info-light);border:1px solid #b3e5fc;border-radius:var(--radius);">
              <strong style="color:var(--info);font-size:14px;">🔐 Security Note</strong>
              <p style="color:var(--text-secondary);font-size:13px;margin-top:4px;">To change your admin password, use the <code>npm run create-admin</code> command to create a new admin account, or update it directly through MongoDB.</p>
            </div>

            <div style="margin-top:16px;">
              <form action="/admin/logout" method="POST">
                <button type="submit" class="btn btn-danger">🚪 Logout</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin.js"></script>
</body>
</html>
