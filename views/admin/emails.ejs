<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    .status-badge-accepted {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #bbf7d0;
      font-weight: 700;
    }
    .status-badge-failed {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      font-weight: 700;
    }
    .status-badge-sending {
      background: #fef3c7;
      color: #b45309;
      border: 1px solid #fde68a;
      font-weight: 700;
    }
    .status-badge-queued {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #e2e8f0;
      font-weight: 700;
    }
    .type-badge-welcome {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
    }
    .type-badge-payment {
      background: #f0fdf4;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    .type-badge-other {
      background: #f8fafc;
      color: #475569;
      border: 1px solid #e2e8f0;
    }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('./partials/sidebar', { currentPage: 'emails' }) %>

  <div class="admin-main">
    <!-- Topbar -->
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle Navigation"><i class="fa-solid fa-bars"></i></button>
      <div class="admin-topbar-title">Email Notifications &amp; Delivery Monitoring</div>
      <div style="font-size:13px;color:var(--text-muted);">
        <i class="fa-solid fa-server"></i> Provider Status: 
        <% if (isConfigured) { %>
          <span style="color:#15803d;font-weight:700;"><i class="fa-solid fa-circle-check"></i> SMTP Configured</span>
        <% } else { %>
          <span style="color:#b45309;font-weight:700;"><i class="fa-solid fa-triangle-exclamation"></i> SMTP Not Set</span>
        <% } %>
      </div>
    </div>

    <!-- Content -->
    <div class="admin-content">

      <!-- SMTP Notice Banner if not configured -->
      <% if (!isConfigured) { %>
      <div style="background:#fffbeb;border:1px solid #fef3c7;border-left:4px solid #f59e0b;border-radius:10px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:14px;">
        <span style="font-size:24px;color:#d97706;line-height:1;"><i class="fa-solid fa-circle-exclamation"></i></span>
        <div style="font-size:13.5px;color:#92400e;line-height:1.5;">
          <strong>SMTP credentials are not configured in .env</strong> (currently set to placeholders <code>EMAIL_USER</code> / <code>EMAIL_PASSWORD</code>).
          <br/>
          All automatic emails are safely recorded in this log with exact timestamps, Student IDs, and attempt counts. To enable live inbox delivery, set up a Google Gmail App Password in <code>.env</code> and use the <strong>Retry</strong> buttons below.
        </div>
      </div>
      <% } %>

      <!-- Metric Stats Cards -->
      <div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-bottom:22px;">
        <div class="stat-card" style="--stat-color:#2563eb;--stat-bg:rgba(37,99,235,0.08);border:1px solid #bfdbfe;">
          <div class="stat-icon"><i class="fa-solid fa-envelope" style="color:#2563eb;"></i></div>
          <div class="stat-info">
            <div class="stat-value" style="color:#1d4ed8;"><%= stats.totalEmails %></div>
            <div class="stat-label">Total Email Events</div>
            <div class="stat-change" style="color:#2563eb;">All automatic &amp; resend triggers</div>
          </div>
        </div>

        <div class="stat-card" style="--stat-color:#16a34a;--stat-bg:rgba(22,163,74,0.08);border:1px solid #bbf7d0;">
          <div class="stat-icon"><i class="fa-solid fa-circle-check" style="color:#16a34a;"></i></div>
          <div class="stat-info">
            <div class="stat-value" style="color:#15803d;"><%= stats.totalAccepted %></div>
            <div class="stat-label">Accepted by Provider</div>
            <div class="stat-change" style="color:#16a34a;">Acknowledged by SMTP</div>
          </div>
        </div>

        <div class="stat-card" style="--stat-color:#dc2626;--stat-bg:rgba(220,38,38,0.08);border:1px solid #fecaca;">
          <div class="stat-icon"><i class="fa-solid fa-circle-xmark" style="color:#dc2626;"></i></div>
          <div class="stat-info">
            <div class="stat-value" style="color:#b91c1c;"><%= stats.totalFailed %></div>
            <div class="stat-label">Failed / Need Config</div>
            <div class="stat-change" style="color:#dc2626;">Logged for retry</div>
          </div>
        </div>

        <div class="stat-card" style="--stat-color:#f59e0b;--stat-bg:rgba(245,158,11,0.08);border:1px solid #fde68a;">
          <div class="stat-icon"><i class="fa-solid fa-clock-rotate-left" style="color:#f59e0b;"></i></div>
          <div class="stat-info">
            <div class="stat-value" style="color:#b45309;"><%= stats.totalSending + stats.totalQueued %></div>
            <div class="stat-label">Queued / In Flight</div>
            <div class="stat-change" style="color:#f59e0b;">Processing pipeline</div>
          </div>
        </div>
      </div>

      <!-- Filters Form -->
      <div class="card" style="padding:16px 20px;margin-bottom:20px;">
        <form method="GET" action="/admin/emails" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <div style="flex:1;min-width:220px;">
            <input 
              type="text" 
              name="search" 
              class="form-control" 
              placeholder="Search by Student ID, name, or email..." 
              value="<%= search || '' %>"
              style="width:100%;padding:9px 14px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;"
            />
          </div>

          <div style="min-width:160px;">
            <select name="status" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
              <option value="">All Statuses</option>
              <option value="accepted" <%= status === 'accepted' ? 'selected' : '' %>>Accepted by Provider</option>
              <option value="failed" <%= status === 'failed' ? 'selected' : '' %>>Failed</option>
              <option value="sending" <%= status === 'sending' ? 'selected' : '' %>>Sending</option>
              <option value="queued" <%= status === 'queued' ? 'selected' : '' %>>Queued</option>
            </select>
          </div>

          <div style="min-width:170px;">
            <select name="type" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
              <option value="">All Email Types</option>
              <option value="welcome" <%= emailType === 'welcome' ? 'selected' : '' %>>Welcome / Student ID</option>
              <option value="payment_confirmation" <%= emailType === 'payment_confirmation' ? 'selected' : '' %>>Payment Confirmation</option>
              <option value="rejection" <%= emailType === 'rejection' ? 'selected' : '' %>>Rejection</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" style="padding:9px 18px;display:inline-flex;align-items:center;gap:6px;">
            <i class="fa-solid fa-filter"></i> Filter
          </button>
          <% if (search || status || emailType) { %>
            <a href="/admin/emails" class="btn btn-ghost btn-sm" style="border:1px solid var(--border);">Reset</a>
          <% } %>
        </form>
      </div>

      <!-- Email Log Table -->
      <div class="card">
        <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;">
          <div class="card-title"><i class="fa-solid fa-list-check"></i> Email Dispatch Log (<%= total %> records)</div>
          <span style="font-size:12.5px;color:var(--text-muted);">Auto-recorded on every event</span>
        </div>

        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Student ID</th>
                <th>Recipient</th>
                <th>Email Type</th>
                <th>Trigger Event</th>
                <th>Status</th>
                <th>Attempts</th>
                <th>Last Attempt</th>
                <th>Details / Provider Info</th>
                <th style="text-align:right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (!logs || logs.length === 0) { %>
                <tr>
                  <td colspan="9" style="text-align:center;padding:36px;color:var(--text-muted);">
                    <i class="fa-regular fa-envelope-open" style="font-size:28px;display:block;margin-bottom:8px;color:#94a3b8;"></i>
                    No email notification logs found matching the filter.
                  </td>
                </tr>
              <% } else { %>
                <% logs.forEach(log => { %>
                  <tr id="email-log-row-<%= log._id %>">
                    <td>
                      <% if (log.studentId) { %>
                        <strong style="font-family:monospace;color:var(--primary);"><%= log.studentId %></strong>
                      <% } else { %>
                        <span style="color:#94a3b8;">N/A</span>
                      <% } %>
                    </td>

                    <td>
                      <div style="font-weight:600;color:var(--text-primary);"><%= log.recipientName || 'Student' %></div>
                      <div style="font-size:12px;color:var(--text-muted);"><%= log.recipientEmail %></div>
                    </td>

                    <td>
                      <% if (log.emailType === 'welcome') { %>
                        <span class="badge type-badge-welcome"><i class="fa-solid fa-id-card"></i> Welcome / ID</span>
                      <% } else if (log.emailType === 'payment_confirmation') { %>
                        <span class="badge type-badge-payment"><i class="fa-solid fa-receipt"></i> Payment Receipt</span>
                      <% } else { %>
                        <span class="badge type-badge-other"><%= log.emailType %></span>
                      <% } %>
                    </td>

                    <td>
                      <span style="font-size:12.5px;font-weight:600;text-transform:capitalize;">
                        <% if (log.triggerEvent === 'registration') { %>
                          <i class="fa-solid fa-user-plus" style="color:var(--primary);font-size:11px;"></i> Registration
                        <% } else if (log.triggerEvent === 'online_payment') { %>
                          <i class="fa-solid fa-credit-card" style="color:#0284c7;font-size:11px;"></i> Online Payment
                        <% } else if (log.triggerEvent === 'cash_verified') { %>
                          <i class="fa-solid fa-money-bill-wave" style="color:#16a34a;font-size:11px;"></i> Cash Verified
                        <% } else if (log.triggerEvent === 'admin_resend') { %>
                          <i class="fa-solid fa-rotate" style="color:#6366f1;font-size:11px;"></i> Admin Resend
                        <% } else { %>
                          <%= log.triggerEvent %>
                        <% } %>
                      </span>
                    </td>

                    <td>
                      <% if (log.status === 'accepted') { %>
                        <span class="badge status-badge-accepted"><i class="fa-solid fa-check"></i> Accepted by Provider</span>
                      <% } else if (log.status === 'failed') { %>
                        <span class="badge status-badge-failed"><i class="fa-solid fa-xmark"></i> Failed</span>
                      <% } else if (log.status === 'sending') { %>
                        <span class="badge status-badge-sending"><i class="fa-solid fa-spinner fa-spin"></i> Sending</span>
                      <% } else { %>
                        <span class="badge status-badge-queued"><i class="fa-solid fa-clock"></i> Queued</span>
                      <% } %>
                    </td>

                    <td style="text-align:center;">
                      <span class="badge badge-gray"><%= log.attemptCount %></span>
                    </td>

                    <td style="font-size:12px;color:var(--text-secondary);white-space:nowrap;">
                      <%= new Date(log.lastAttemptAt || log.createdAt).toLocaleString('en-IN', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %>
                    </td>

                    <td style="max-width:240px;">
                      <% if (log.status === 'accepted') { %>
                        <span style="font-size:11.5px;color:#166534;font-family:monospace;" title="Message ID">
                          <i class="fa-solid fa-paper-plane"></i> <%= log.messageId || 'Provider confirmed' %>
                        </span>
                      <% } else if (log.errorInfo) { %>
                        <span style="font-size:11.5px;color:#b91c1c;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= log.errorInfo %>">
                          <i class="fa-solid fa-triangle-exclamation"></i> <%= log.errorInfo %>
                        </span>
                      <% } else { %>
                        <span style="font-size:11.5px;color:var(--text-muted);">In progress</span>
                      <% } %>
                    </td>

                    <td style="text-align:right;">
                      <% if (log.status === 'failed' || log.status === 'queued') { %>
                        <button 
                          type="button" 
                          class="btn btn-sm btn-ghost" 
                          onclick="retryEmail('<%= log._id %>', this)" 
                          style="font-size:12px;padding:5px 10px;border:1px solid #cbd5e1;"
                          title="Retry Email Send"
                        >
                          <i class="fa-solid fa-rotate-right"></i> Retry
                        </button>
                      <% } else { %>
                        <button 
                          type="button" 
                          class="btn btn-sm btn-ghost" 
                          onclick="retryEmail('<%= log._id %>', this)" 
                          style="font-size:12px;padding:5px 10px;color:#64748b;"
                          title="Force Resend Email"
                        >
                          <i class="fa-solid fa-envelope"></i> Resend
                        </button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div style="padding:16px 20px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
            <div style="font-size:13px;color:var(--text-muted);">
              Showing Page <strong><%= page %></strong> of <strong><%= totalPages %></strong> (<%= total %> total logs)
            </div>
            <div style="display:flex;gap:6px;">
              <% if (page > 1) { %>
                <a href="/admin/emails?page=<%= page - 1 %>&search=<%= search %>&status=<%= status %>&type=<%= emailType %>" class="btn btn-sm btn-ghost">← Previous</a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="/admin/emails?page=<%= page + 1 %>&search=<%= search %>&status=<%= status %>&type=<%= emailType %>" class="btn btn-sm btn-ghost">Next →</a>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>

    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script src="/js/admin.js"></script>
<script>
  async function retryEmail(logId, btn) {
    if (btn) {
      btn.disabled = true;
      btn.dataset.origHtml = btn.innerHTML;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Retrying...';
    }

    try {
      const res = await fetch(`/admin/emails/${logId}/retry`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      const data = await res.json();
      if (data.success) {
        showToast('✅ ' + (data.message || 'Email retried successfully!'), 'success');
        setTimeout(() => location.reload(), 900);
      } else {
        showToast('❌ ' + (data.message || 'Retry failed'), 'danger');
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = btn.dataset.origHtml || '<i class="fa-solid fa-rotate-right"></i> Retry';
        }
      }
    } catch (err) {
      showToast('❌ Server error: ' + err.message, 'danger');
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = btn.dataset.origHtml || '<i class="fa-solid fa-rotate-right"></i> Retry';
      }
    }
  }
</script>
</body>
</html>
