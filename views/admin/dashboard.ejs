<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
<div class="admin-wrapper">

  <%- include('./partials/sidebar', { currentPage: 'dashboard', pendingCount: stats.pendingStudents }) %>

  <div class="admin-main">
    <!-- Topbar -->
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()">☰</button>
      <div class="admin-topbar-title">Dashboard</div>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:13px;color:var(--text-muted);">
          <%= new Date().toLocaleDateString('en-IN', {weekday:'long', day:'2-digit', month:'long', year:'numeric'}) %>
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="admin-content">

      <!-- Welcome Banner -->
      <div style="background:linear-gradient(135deg,var(--primary) 0%,var(--primary-light) 100%);border-radius:var(--radius-lg);padding:24px 28px;margin-bottom:28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div>
          <div style="color:rgba(255,255,255,0.7);font-size:13px;margin-bottom:4px;">Welcome back,</div>
          <div style="color:#fff;font-size:20px;font-weight:700;"><%= admin.name %></div>
          <div style="color:rgba(255,255,255,0.6);font-size:13px;margin-top:4px;">
            <% if (stats.pendingStudents > 0) { %>
              ⚠️ You have <strong style="color:var(--accent);"><%= stats.pendingStudents %></strong> pending registration<%= stats.pendingStudents > 1 ? 's' : '' %> awaiting Student ID assignment
            <% } else { %>
              ✅ All registrations are up to date
            <% } %>
          </div>
        </div>
        <a href="/admin/students?status=pending&payment=paid" class="btn btn-accent">
          Pending Approvals →
        </a>
      </div>

      <!-- Stats Cards -->
      <!-- 7 Dashboard Statistics -->
      <div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <div class="stat-card" style="--stat-color:var(--primary);--stat-bg:rgba(26,35,126,0.1);">
          <div class="stat-icon">👥</div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.totalStudents %></div>
            <div class="stat-label">Total Students</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:var(--success);--stat-bg:rgba(46,125,50,0.1);">
          <div class="stat-icon">✅</div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.activeStudents %></div>
            <div class="stat-label">Active Students</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:#d97706;--stat-bg:rgba(217,119,6,0.1);border:1px solid #fde68a;">
          <div class="stat-icon">💵</div>
          <div class="stat-info">
            <div class="stat-value" style="color:#d97706;"><%= stats.pendingCashPayments %></div>
            <div class="stat-label">Pending Cash Payments</div>
            <div class="stat-change" style="color:#d97706;">Action required at counter</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:#0284c7;--stat-bg:rgba(2,132,199,0.1);">
          <div class="stat-icon">💳</div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.onlinePayments %></div>
            <div class="stat-label">Online Payments</div>
            <div class="stat-change" style="color:#0284c7;">Auto-Approved & Paid</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:#059669;--stat-bg:rgba(5,150,105,0.1);">
          <div class="stat-icon">🧾</div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.cashPayments %></div>
            <div class="stat-label">Cash Payments</div>
            <div class="stat-change" style="color:#059669;">Verified by Admin</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:#16a34a;--stat-bg:rgba(22,163,74,0.1);">
          <div class="stat-icon">💰</div>
          <div class="stat-info">
            <div class="stat-value">₹<%= stats.totalRevenue.toLocaleString() %></div>
            <div class="stat-label">Total Revenue</div>
            <div class="stat-change" style="color:var(--success);">₹150 fee per student</div>
          </div>
        </div>
        <div class="stat-card" style="--stat-color:var(--warning);--stat-bg:rgba(245,127,23,0.1);">
          <div class="stat-icon">⏳</div>
          <div class="stat-info">
            <div class="stat-value"><%= stats.pendingApprovals %></div>
            <div class="stat-label">Pending Approvals</div>
          </div>
        </div>
      </div>

      <!-- Pending Cash Payments Section & Recent Registrations -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">

        <!-- Section: PENDING CASH PAYMENTS -->
        <div class="card" style="border: 2px solid #fed7aa;">
          <div class="card-header" style="background:#fff7ed;">
            <div class="card-title" style="color:#9a3412;">💵 PENDING CASH PAYMENTS</div>
            <span class="badge" style="background:#ffedd5;color:#c2410c;font-weight:700;"><%= pendingCashStudents ? pendingCashStudents.length : 0 %> Pending</span>
          </div>
          <div class="card-body" style="padding:0;">
            <% if (!pendingCashStudents || pendingCashStudents.length === 0) { %>
              <div style="text-align:center;padding:36px;color:var(--text-muted);font-size:14px;">
                ✅ No pending cash payments. All caught up!
              </div>
            <% } else { %>
              <% pendingCashStudents.forEach(s => { %>
              <div class="notification-item" style="padding:16px 20px;border-bottom:1px solid var(--border);">
                <div class="avatar-circle" style="background:#ffedd5;color:#c2410c;width:40px;height:40px;font-weight:700;">
                  <%= s.fullName.charAt(0).toUpperCase() %>
                </div>
                <div class="notification-info" style="flex:1;">
                  <div class="notification-name" style="font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px;">
                    <%= s.fullName %>
                    <span style="font-family:monospace;font-size:12px;background:#f1f5f9;color:#475569;padding:2px 6px;border-radius:4px;"><%= s.studentId %></span>
                  </div>
                  <div class="notification-meta" style="margin-top:3px;font-size:13px;">
                    📞 <%= s.mobile %> &nbsp;|&nbsp; ✉️ <%= s.email %>
                  </div>
                  <div style="font-size:12px;color:#d97706;margin-top:4px;font-weight:600;">
                    💳 ₹150 Cash Pending • Reg: <%= new Date(s.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %>
                  </div>
                </div>
                <div class="notification-actions" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                  <a href="/admin/students/<%= s._id %>" class="btn btn-ghost btn-sm" title="View Details">👁 View</a>
                  <button
                    class="btn btn-success btn-sm"
                    onclick="openCashModal('<%= s._id %>', '<%= s.fullName %>')"
                    title="Approve Cash & Send Email"
                    style="background:#059669;border:none;font-weight:700;"
                  >
                    ✓ Approve & Send Email
                  </button>
                  <button
                    class="btn btn-danger btn-sm"
                    onclick="rejectStudent('<%= s._id %>', '<%= s.fullName %>', this)"
                    title="Reject Application"
                  >
                    ✗ Reject
                  </button>
                </div>
              </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Recent Registrations -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">🕐 Recent Registrations</div>
            <a href="/admin/students" class="btn btn-sm btn-ghost">All Students</a>
          </div>
          <div class="card-body" style="padding:0;">
            <% if (!recentStudents || recentStudents.length === 0) { %>
              <div style="text-align:center;padding:32px;color:var(--text-muted);font-size:14px;">
                No registrations yet
              </div>
            <% } else { %>
              <% recentStudents.slice(0, 7).forEach(s => { %>
              <div class="notification-item" style="padding:12px 20px;border-bottom:1px solid var(--border);">
                <div class="avatar-circle" style="width:36px;height:36px;font-size:14px;"><%= s.fullName.charAt(0).toUpperCase() %></div>
                <div class="notification-info">
                  <div class="notification-name" style="font-size:14px;font-weight:600;">
                    <%= s.fullName %>
                    <% if (s.paymentMethod === 'online') { %>
                      <span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:11px;padding:2px 6px;">Online</span>
                    <% } else { %>
                      <span class="badge" style="background:#fef3c7;color:#92400e;font-size:11px;padding:2px 6px;">Cash</span>
                    <% } %>
                  </div>
                  <div class="notification-meta">
                    <% if (s.studentId) { %><span style="color:var(--primary);font-weight:600;"><%= s.studentId %></span> | <% } %>
                    <%= s.email %>
                  </div>
                </div>
                <div>
                  <% if (s.accountStatus === 'active') { %>
                    <span class="badge badge-success">✓ Active</span>
                  <% } else if (s.accountStatus === 'pending') { %>
                    <span class="badge badge-warning">⏳ Pending</span>
                  <% } else if (s.accountStatus === 'rejected') { %>
                    <span class="badge badge-danger">✗ Rejected</span>
                  <% } else { %>
                    <span class="badge badge-gray">Inactive</span>
                  <% } %>
                </div>
              </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<script src="/js/admin.js"></script>
</body>
</html>
