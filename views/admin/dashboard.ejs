<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | <%= libraryName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
<div class="admin-wrapper">

  <%- include('./partials/sidebar', { currentPage: 'dashboard', pendingCount: stats.pendingCashPayments }) %>

  <div class="admin-main">
    <!-- Topbar -->
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
      <div class="admin-topbar-title">Dashboard Overview</div>
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:13px;color:var(--text-muted);">
          <i class="fa-regular fa-calendar"></i> <%= new Date().toLocaleDateString('en-IN', {weekday:'long', day:'2-digit', month:'long', year:'numeric'}) %>
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="admin-content">

      <!-- Welcome Banner -->
      <div style="background:linear-gradient(135deg,var(--primary) 0%,var(--primary-light) 100%);border-radius:var(--radius-lg);padding:24px 28px;margin-bottom:28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div>
          <div style="color:rgba(255,255,255,0.7);font-size:13px;margin-bottom:4px;">Welcome back,</div>
          <div style="color:#fff;font-size:22px;font-weight:800;"><%= admin.name %></div>
          <div style="color:rgba(255,255,255,0.85);font-size:13px;margin-top:6px;display:flex;align-items:center;gap:8px;">
            <% if (stats.pendingCashPayments > 0) { %>
              <i class="fa-solid fa-triangle-exclamation" style="color:var(--accent);"></i>
              <span>You have <strong style="color:var(--accent);"><%= stats.pendingCashPayments %></strong> pending cash payment<%= stats.pendingCashPayments > 1 ? 's' : '' %> to verify at the desk.</span>
            <% } else { %>
              <i class="fa-solid fa-circle-check" style="color:#86efac;"></i>
              <span>All registrations and cash collections are up to date!</span>
            <% } %>
          </div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/admin/students" class="btn btn-ghost" style="color:#fff;border-color:rgba(255,255,255,0.4);">
            <i class="fa-solid fa-users"></i> Manage Students
          </a>
          <a href="/admin/students?payment=pending" class="btn btn-accent">
            <i class="fa-solid fa-money-bill-wave"></i> Pending Cash Payments →
          </a>
        </div>
      </div>

      <!-- Quick Section Pills -->
      <div style="display:flex;gap:10px;margin-bottom:24px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:4px;">
        <a href="/admin/dashboard" class="btn btn-sm btn-primary" style="white-space:nowrap;font-size:12.5px;"><i class="fa-solid fa-gauge-high"></i> Overview</a>
        <a href="/admin/students" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-users"></i> Student Management</a>
        <a href="/admin/seats" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-chair"></i> Seat Management (43)</a>
        <a href="/admin/bookings" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-calendar-check"></i> Booking Management</a>
        <a href="/admin/payments" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-credit-card"></i> Payments</a>
        <a href="/admin/emails" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-envelope-circle-check"></i> Email Notifications</a>
        <a href="/admin/profile" class="btn btn-sm btn-ghost" style="white-space:nowrap;font-size:12.5px;border:1px solid var(--border);"><i class="fa-solid fa-sliders"></i> Settings</a>
      </div>

      <!-- Physical Seat Overview Stats (43 Seats) -->
      <div class="mb-24">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
          <h2 style="font-size:17px;font-weight:700;color:var(--text);margin:0;display:flex;align-items:center;gap:8px;">
            <i class="fa-solid fa-chair" style="color:var(--primary);"></i> Physical Study Seats Overview
          </h2>
          <div style="display:flex;gap:8px;">
            <a href="/admin/seats" class="btn btn-sm btn-primary" style="font-size:12px;"><i class="fa-solid fa-compass-drafting"></i> 43-Seat Layout →</a>
            <a href="/admin/bookings" class="btn btn-sm btn-ghost" style="font-size:12px;"><i class="fa-solid fa-calendar-check"></i> All Bookings →</a>
          </div>
        </div>

        <div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));gap:16px;">
          <div class="stat-card" style="--stat-color:#2563eb;--stat-bg:rgba(37,99,235,0.1);border:1px solid #bfdbfe;">
            <div class="stat-icon"><i class="fa-solid fa-chair" style="color:#2563eb;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#1d4ed8;">43</div>
              <div class="stat-label">Total Study Desks</div>
              <div class="stat-change" style="color:#2563eb;">Complete hall capacity</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:#16a34a;--stat-bg:rgba(22,163,74,0.1);border:1px solid #bbf7d0;">
            <div class="stat-icon"><i class="fa-solid fa-circle-check" style="color:#16a34a;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#15803d;"><%= stats.availableSeats || 0 %></div>
              <div class="stat-label">Available Desks</div>
              <div class="stat-change" style="color:#16a34a;">Vacant &amp; ready to book</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:#dc2626;--stat-bg:rgba(220,38,38,0.1);border:1px solid #fecaca;">
            <div class="stat-icon"><i class="fa-solid fa-user-check" style="color:#dc2626;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#b91c1c;"><%= stats.occupiedSeats || 0 %></div>
              <div class="stat-label">Occupied Desks</div>
              <div class="stat-change" style="color:#dc2626;">Assigned to students</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:#64748b;--stat-bg:rgba(100,116,139,0.1);border:1px solid #e2e8f0;">
            <div class="stat-icon"><i class="fa-solid fa-lock" style="color:#64748b;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#475569;">5</div>
              <div class="stat-label">Locked / Unavailable</div>
              <div class="stat-change" style="color:#64748b;">Seats 13, 14, 15, 17, 19</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Student Overview Stats -->
      <div class="mb-24">
        <h2 style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
          <i class="fa-solid fa-users" style="color:var(--primary);"></i> Student Records Overview
        </h2>
        <div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));gap:16px;">
          <div class="stat-card" style="--stat-color:var(--primary);--stat-bg:rgba(26,35,126,0.1);">
            <div class="stat-icon"><i class="fa-solid fa-user-graduate" style="color:var(--primary);"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.totalStudents %></div>
              <div class="stat-label">Total Students</div>
              <div class="stat-change" style="color:var(--primary);">All registered records</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:var(--success);--stat-bg:rgba(46,125,50,0.1);">
            <div class="stat-icon"><i class="fa-solid fa-circle-check" style="color:var(--success);"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.activeStudents %></div>
              <div class="stat-label">Active Students</div>
              <div class="stat-change" style="color:var(--success);">Permitted portal access</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:var(--warning);--stat-bg:rgba(245,127,23,0.1);">
            <div class="stat-icon"><i class="fa-solid fa-hourglass-half" style="color:var(--warning);"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.pendingApprovals %></div>
              <div class="stat-label">Pending Approvals</div>
              <div class="stat-change" style="color:var(--warning);">Requires admin action</div>
            </div>
          </div>

          <div class="stat-card" style="--stat-color:#d97706;--stat-bg:rgba(217,119,6,0.1);border:1px solid #fde68a;">
            <div class="stat-icon"><i class="fa-solid fa-calendar-days" style="color:#d97706;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#b45309;"><%= stats.activeBookings || 0 %></div>
              <div class="stat-label">Active Bookings</div>
              <div class="stat-change" style="color:#d97706;">Live student sessions</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Overview Section -->
      <div class="mb-24">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;flex-wrap:wrap;gap:8px;">
          <h2 style="font-size:17px;font-weight:700;color:var(--text);margin:0;display:flex;align-items:center;gap:8px;">
            <i class="fa-solid fa-credit-card" style="color:var(--primary);"></i> Revenue &amp; Payments
          </h2>
          <a href="/admin/payments" class="btn btn-sm btn-ghost" style="font-size:12px;"><i class="fa-solid fa-receipt"></i> All Payments →</a>
        </div>

        <div class="admin-stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));gap:16px;">
          <!-- 1. Total Revenue -->
          <div class="stat-card" style="--stat-color:#16a34a;--stat-bg:rgba(22,163,74,0.1);border:1px solid #bbf7d0;">
            <div class="stat-icon"><i class="fa-solid fa-coins" style="color:#16a34a;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#15803d;">₹<%= (stats.totalRevenue || 0).toLocaleString('en-IN') %></div>
              <div class="stat-label">Total Revenue</div>
              <div class="stat-change" style="color:#16a34a;">From verified fees</div>
            </div>
          </div>

          <!-- 2. Online Revenue -->
          <div class="stat-card" style="--stat-color:#0284c7;--stat-bg:rgba(2,132,199,0.1);border:1px solid #bae6fd;">
            <div class="stat-icon"><i class="fa-solid fa-credit-card" style="color:#0284c7;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#0369a1;">₹<%= (stats.onlineRevenue || 0).toLocaleString('en-IN') %></div>
              <div class="stat-label">Online Revenue</div>
              <div class="stat-change" style="color:#0284c7;"><%= stats.onlinePayments || 0 %> paid transactions</div>
            </div>
          </div>

          <!-- 3. Cash Revenue -->
          <div class="stat-card" style="--stat-color:#059669;--stat-bg:rgba(5,150,105,0.1);border:1px solid #a7f3d0;">
            <div class="stat-icon"><i class="fa-solid fa-money-bill-wave" style="color:#059669;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#047857;">₹<%= (stats.cashRevenue || 0).toLocaleString('en-IN') %></div>
              <div class="stat-label">Cash Revenue</div>
              <div class="stat-change" style="color:#059669;"><%= stats.cashPayments || 0 %> counter collections</div>
            </div>
          </div>

          <!-- 4. Pending Cash Payments -->
          <div class="stat-card" style="--stat-color:#d97706;--stat-bg:rgba(217,119,6,0.1);border:1px solid #fde68a;">
            <div class="stat-icon"><i class="fa-solid fa-clock-rotate-left" style="color:#d97706;"></i></div>
            <div class="stat-info">
              <div class="stat-value" style="color:#b45309;"><%= stats.pendingCashPayments || 0 %></div>
              <div class="stat-label">Pending Cash Payments</div>
              <div class="stat-change" style="color:#d97706;">Awaiting desk collection</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pending Cash Payments Section & Recent Registrations -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(360px, 1fr));gap:24px;">

        <!-- Section: PENDING CASH PAYMENTS -->
        <div class="card" style="border: 2px solid #fed7aa;">
          <div class="card-header" style="background:#fff7ed;display:flex;justify-content:space-between;align-items:center;">
            <div class="card-title" style="color:#9a3412;"><i class="fa-solid fa-money-bill-wave"></i> PENDING CASH PAYMENTS</div>
            <span class="badge" style="background:#ffedd5;color:#c2410c;font-weight:700;"><%= pendingCashStudents ? pendingCashStudents.length : 0 %> Pending</span>
          </div>
          <div class="card-body" style="padding:0;">
            <% if (!pendingCashStudents || pendingCashStudents.length === 0) { %>
              <div style="text-align:center;padding:36px;color:var(--text-muted);font-size:14px;">
                <i class="fa-solid fa-circle-check" style="color:#16a34a;"></i> No pending cash payments. All caught up!
              </div>
            <% } else { %>
              <% pendingCashStudents.forEach(s => { %>
              <div class="notification-item" id="pending-cash-<%= s._id %>" style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:14px;">
                <div class="avatar-circle" style="background:#ffedd5;color:#c2410c;width:40px;height:40px;font-weight:700;flex-shrink:0;">
                  <%= s.fullName.charAt(0).toUpperCase() %>
                </div>
                <div class="notification-info" style="flex:1;min-width:0;">
                  <div class="notification-name" style="font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span><%= s.fullName %></span>
                    <% if (s.studentId) { %>
                      <span style="font-family:monospace;font-size:11px;background:#f1f5f9;color:#475569;padding:2px 6px;border-radius:4px;"><%= s.studentId %></span>
                    <% } %>
                  </div>
                  <div class="notification-meta" style="margin-top:2px;font-size:12px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    <i class="fa-solid fa-phone" style="font-size:10px;"></i> <%= s.mobile %> &nbsp;|&nbsp; <i class="fa-solid fa-envelope" style="font-size:10px;"></i> <%= s.email %>
                  </div>
                  <div style="font-size:12px;color:#d97706;margin-top:3px;font-weight:600;">
                    <i class="fa-solid fa-clock"></i> ₹150 Cash Pending • <%= new Date(s.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %>
                  </div>
                </div>
                <div class="notification-actions" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;flex-shrink:0;">
                  <a href="/admin/students/<%= s._id %>" class="btn btn-ghost btn-sm" title="View Details">
                    <i class="fa-solid fa-eye"></i> View
                  </a>
                  <button
                    class="btn btn-success btn-sm"
                    onclick="openCashModal('<%= s._id %>', '<%= s.fullName %>')"
                    title="Mark Cash Payment Received"
                    style="background:#059669;border:none;font-weight:700;"
                  >
                    <i class="fa-solid fa-check"></i> Mark Cash Paid
                  </button>
                </div>
              </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Recent Registrations -->
        <div class="card">
          <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
            <div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> Recent Registrations</div>
            <a href="/admin/students" class="btn btn-sm btn-ghost">All Students →</a>
          </div>
          <div class="card-body" style="padding:0;">
            <% if (!recentStudents || recentStudents.length === 0) { %>
              <div style="text-align:center;padding:32px;color:var(--text-muted);font-size:14px;">
                No registrations yet
              </div>
            <% } else { %>
              <% recentStudents.slice(0, 7).forEach(s => { %>
              <div class="notification-item" style="padding:12px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;">
                <div class="avatar-circle" style="width:36px;height:36px;font-size:13px;flex-shrink:0;"><%= s.fullName.charAt(0).toUpperCase() %></div>
                <div class="notification-info" style="flex:1;min-width:0;">
                  <div class="notification-name" style="font-size:14px;font-weight:600;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                    <span><%= s.fullName %></span>
                    <% if (s.paymentMethod === 'online') { %>
                      <span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:11px;padding:2px 6px;"><i class="fa-solid fa-credit-card"></i> Online</span>
                    <% } else { %>
                      <span class="badge" style="background:#fef3c7;color:#92400e;font-size:11px;padding:2px 6px;"><i class="fa-solid fa-money-bill-wave"></i> Cash</span>
                    <% } %>
                  </div>
                  <div class="notification-meta" style="font-size:12px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    <% if (s.studentId) { %><strong style="color:var(--primary);font-family:monospace;"><%= s.studentId %></strong> • <% } %>
                    <%= s.email %>
                  </div>
                </div>
                <div style="flex-shrink:0;">
                  <% if (s.accountStatus === 'active') { %>
                    <span class="badge badge-success"><i class="fa-solid fa-check"></i> Active</span>
                  <% } else if (s.accountStatus === 'pending') { %>
                    <span class="badge badge-warning">⏳ Pending</span>
                  <% } else if (s.accountStatus === 'rejected') { %>
                    <span class="badge badge-danger"><i class="fa-solid fa-xmark"></i> Rejected</span>
                  <% } else { %>
                    <span class="badge badge-gray">Inactive</span>
                  <% } %>
                </div>
              </div>
              <% }) %>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script src="/js/admin.js"></script>
</body>
</html>
