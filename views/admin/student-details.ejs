<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Details | <%= libraryName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
<div class="admin-wrapper">
  <%- include('./partials/sidebar', { currentPage: 'students' }) %>

  <div class="admin-main">
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle Sidebar"><i class="fa-solid fa-bars"></i></button>
      <div class="admin-topbar-title">
        <a href="/admin/students" style="color:var(--text-muted);font-weight:400;">Students</a>
        &nbsp;/&nbsp; <%= student.fullName %>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button type="button" onclick="openEditStudentModal()" class="btn btn-primary btn-sm" style="background:#2563eb;display:inline-flex;align-items:center;gap:6px;">
          <i class="fa-solid fa-pen-to-square"></i> Edit Student
        </button>
        <a href="/admin/students/<%= student._id %>/print" target="_blank" class="btn btn-ghost btn-sm" style="border:1px solid var(--border);display:inline-flex;align-items:center;gap:6px;">
          <i class="fa-solid fa-print"></i> Print Form
        </a>
      </div>
    </div>

    <div class="admin-content">

      <!-- Status Banners -->
      <% if (student.paymentMethod === 'cash' && student.paymentStatus === 'pending') { %>
      <div style="background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:var(--radius-lg);padding:20px 24px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;color:#fff;">
        <div style="display:flex;align-items:center;gap:14px;">
          <span style="font-size:28px;"><i class="fa-solid fa-money-bill-wave"></i></span>
          <div>
            <div style="font-weight:800;font-size:17px;">Cash Payment Pending Desk Verification</div>
            <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:2px;">
              Student selected Cash payment • Amount Due: <strong>₹150</strong> • Student ID: <strong><%= student.studentId || 'LIB' %></strong>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="btn btn-success" onclick="openCashModal('<%= student._id %>', '<%= student.fullName %>')" style="background:#059669;border:none;padding:10px 20px;font-weight:700;display:inline-flex;align-items:center;gap:6px;">
            <i class="fa-solid fa-check"></i> Mark Cash Paid &amp; Activate
          </button>
        </div>
      </div>
      <% } else if (student.accountStatus === 'inactive') { %>
      <div style="background:linear-gradient(135deg,#64748b,#475569);border-radius:var(--radius-lg);padding:18px 22px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;color:#fff;">
        <div style="display:flex;align-items:center;gap:14px;">
          <span style="font-size:24px;"><i class="fa-solid fa-circle-pause"></i></span>
          <div>
            <div style="font-weight:700;font-size:16px;">Account Inactive</div>
            <div style="color:rgba(255,255,255,0.85);font-size:13px;margin-top:2px;">
              This student is currently deactivated and cannot log in to the student portal.
            </div>
          </div>
        </div>
        <button class="btn btn-success" onclick="activateStudent('<%= student._id %>','<%= student.fullName %>', this)" style="background:#10b981;border:none;display:inline-flex;align-items:center;gap:6px;">
          <i class="fa-solid fa-play"></i> Activate Account
        </button>
      </div>
      <% } else if (student.accountStatus === 'active') { %>
      <div style="background:linear-gradient(135deg,#059669,#047857);border-radius:var(--radius-lg);padding:18px 22px;margin-bottom:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;color:#fff;">
        <div style="display:flex;align-items:center;gap:14px;">
          <span style="font-size:24px;"><i class="fa-solid fa-circle-check"></i></span>
          <div>
            <div style="font-weight:700;font-size:16px;">
              Account Active • <%= student.paymentMethod === 'online' ? 'Online Payment Verified' : 'Cash Payment Verified' %> (₹150)
            </div>
            <div style="color:rgba(255,255,255,0.9);font-size:13px;margin-top:2px;">
              Student ID: <strong><%= student.studentId %></strong> • Email Status: <strong><%= student.emailStatus %></strong>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="btn btn-sm btn-ghost" onclick="resendEmail('<%= student._id %>','<%= student.fullName %>', this)" style="color:#fff;border-color:rgba(255,255,255,0.5);display:inline-flex;align-items:center;gap:6px;"><i class="fa-solid fa-envelope"></i> Resend Email</button>
          <button class="btn btn-sm btn-warning" onclick="deactivateStudent('<%= student._id %>','<%= student.fullName %>', this)" style="display:inline-flex;align-items:center;gap:6px;"><i class="fa-solid fa-pause"></i> Deactivate</button>
        </div>
      </div>
      <% } %>

      <div class="detail-grid">
        <!-- Left: Profile Summary Card & Actions -->
        <div>
          <div class="detail-sidebar-card mb-24">
            <div class="detail-avatar"><%= student.fullName.charAt(0).toUpperCase() %></div>
            <h2 style="font-size:18px;margin-bottom:4px;"><%= student.fullName %></h2>
            <p style="color:var(--text-muted);font-size:13px;margin-bottom:14px;"><%= student.email %></p>

            <% if (student.studentId) { %>
              <div style="background:var(--primary);color:#fff;border-radius:var(--radius);padding:10px;font-weight:700;font-size:16px;letter-spacing:2px;margin-bottom:14px;font-family:monospace;"><%= student.studentId %></div>
            <% } %>

            <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;">
              <!-- Payment Method Badge -->
              <span class="badge" style="justify-content:center;padding:7px;<%= student.paymentMethod === 'online' ? 'background:#e0f2fe;color:#0369a1;' : 'background:#fef3c7;color:#92400e;' %> font-weight:700;display:inline-flex;align-items:center;gap:6px;">
                <i class="<%= student.paymentMethod === 'online' ? 'fa-solid fa-credit-card' : 'fa-solid fa-money-bill-wave' %>"></i> <%= student.paymentMethod === 'online' ? 'Online Payment' : 'Cash Payment' %>
              </span>

              <!-- Payment Status Badge -->
              <% if (student.paymentStatus === 'paid') { %>
                <span class="badge badge-success" style="justify-content:center;padding:7px;"><i class="fa-solid fa-check"></i> Paid (₹150)</span>
              <% } else { %>
                <span class="badge badge-warning" style="justify-content:center;padding:7px;background:#fff7ed;color:#c2410c;"><i class="fa-solid fa-clock"></i> Payment Pending (₹150)</span>
              <% } %>

              <!-- Approval Status Badge -->
              <% if (student.approvalStatus === 'approved') { %>
                <span class="badge badge-success" style="justify-content:center;padding:7px;"><i class="fa-solid fa-check"></i> Approved</span>
              <% } else if (student.approvalStatus === 'rejected') { %>
                <span class="badge badge-danger" style="justify-content:center;padding:7px;"><i class="fa-solid fa-xmark"></i> Rejected</span>
              <% } else { %>
                <span class="badge badge-warning" style="justify-content:center;padding:7px;"><i class="fa-solid fa-clock"></i> Approval Pending</span>
              <% } %>

              <!-- Account Status Badge -->
              <span id="detail-account-badge" class="badge <%= student.accountStatus === 'active' ? 'badge-success' : (student.accountStatus === 'pending' ? 'badge-warning' : 'badge-gray') %>" style="justify-content:center;padding:7px;">
                <%= student.accountStatus === 'active' ? 'Account Active' : (student.accountStatus === 'pending' ? 'Account Pending' : 'Account Inactive') %>
              </span>
            </div>

            <!-- Action Buttons Grid -->
            <div class="action-buttons-grid" style="display:flex;flex-direction:column;gap:8px;">
              <button type="button" onclick="openEditStudentModal()" class="btn btn-primary btn-block" style="background:#2563eb;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;gap:6px;">
                <i class="fa-solid fa-pen-to-square"></i> Edit Student
              </button>

              <a href="/admin/students/<%= student._id %>/print" target="_blank" class="btn btn-ghost btn-block" style="border:1px solid var(--border);color:var(--text-primary);text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;">
                <i class="fa-solid fa-print"></i> Print Registration Form
              </a>

              <% if (student.paymentMethod === 'cash' && student.paymentStatus === 'pending') { %>
                <button class="btn btn-success btn-block" onclick="openCashModal('<%= student._id %>', '<%= student.fullName %>')" style="background:#059669;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;gap:6px;">
                  <i class="fa-solid fa-money-bill-wave"></i> Mark Cash Payment Received
                </button>
              <% } %>

              <% if (student.accountStatus === 'active') { %>
                <button class="btn btn-warning btn-block" id="detail-toggle-btn" onclick="deactivateStudent('<%= student._id %>','<%= student.fullName %>', this)" style="display:flex;align-items:center;justify-content:center;gap:6px;">
                  <i class="fa-solid fa-pause"></i> Deactivate Account
                </button>
              <% } else { %>
                <button class="btn btn-success btn-block" id="detail-toggle-btn" onclick="activateStudent('<%= student._id %>','<%= student.fullName %>', this)" style="display:flex;align-items:center;justify-content:center;gap:6px;">
                  <i class="fa-solid fa-play"></i> Activate Account
                </button>
              <% } %>

              <button class="btn btn-ghost btn-block" onclick="resendEmail('<%= student._id %>','<%= student.fullName %>', this)" style="display:flex;align-items:center;justify-content:center;gap:6px;">
                <i class="fa-solid fa-envelope"></i> <%= student.emailStatus === 'sent' ? 'Resend Confirmation Email' : 'Send Confirmation Email' %>
              </button>

              <button class="btn btn-danger btn-block" onclick="confirmDeleteStudent('<%= student._id %>', '<%= student.fullName %>')" style="display:flex;align-items:center;justify-content:center;gap:6px;">
                <i class="fa-solid fa-trash"></i> Delete Student
              </button>
            </div>
          </div>
        </div>

        <!-- Right: 8 Organized Information Sections -->
        <div>

          <!-- 1. Personal Information -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-user"></i> Personal Information</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Full Name</td><td><strong><%= student.fullName %></strong></td></tr>
                <tr><td>Parent/Guardian Name</td><td><%= student.parentName %></td></tr>
                <tr><td>Date of Birth</td><td><%= new Date(student.dateOfBirth).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></td></tr>
                <tr><td>Gender</td><td style="text-transform:capitalize;"><%= student.gender %></td></tr>
                <tr><td>Residential Address</td><td><%= student.address %><%= student.city ? ', ' + student.city : '' %><%= student.state ? ', ' + student.state : '' %><%= student.pincode ? ' - ' + student.pincode : '' %></td></tr>
              </table>
            </div>
          </div>

          <!-- 2. Contact Information -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-phone"></i> Contact Information</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Contact Number</td><td><%= student.mobile %></td></tr>
                <tr><td>Emergency Contact Number</td><td><%= student.emergencyContact || 'N/A' %></td></tr>
                <tr><td>Email Address</td><td><%= student.email %></td></tr>
              </table>
            </div>
          </div>

          <!-- 3. Identification -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-id-card"></i> Identification</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>ID Proof Type</td><td><%= student.idProofType || 'Aadhaar Card' %></td></tr>
                <tr><td>ID Proof Number</td><td style="font-family:monospace;font-weight:600;"><%= student.idProofNumber || 'N/A' %></td></tr>
              </table>
            </div>
          </div>

          <!-- 4. Education -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-graduation-cap"></i> Education</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Education Level</td><td><%= student.educationLevel || (student.course ? student.course + (student.semester ? ' (' + student.semester + ')' : '') : 'Undergraduate') %></td></tr>
                <tr><td>Preparing For</td><td><%= student.preparingFor || 'Competitive Exams / Self Study' %></td></tr>
              </table>
            </div>
          </div>

          <!-- 5. Membership Details -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-book-bookmark"></i> Membership Details</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Membership Slot</td><td><%= student.membershipSlot || 'Full Day Slot' %></td></tr>
                <tr><td>Subscription Plan</td><td><%= student.subscriptionPlan || '1 Month Plan' %></td></tr>
                <tr><td>Slot Timing</td><td><%= student.slotTiming || '6:00 AM - 10:00 PM' %></td></tr>
                <tr><td>Joining Date</td><td><%= new Date(student.joiningDate).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></td></tr>
                <tr><td>Registration Date</td><td><%= new Date(student.registrationDate || student.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric'}) %></td></tr>
              </table>
            </div>
          </div>

          <!-- 6. Payment Information -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-receipt"></i> Payment Details</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Registration Fee</td><td><strong>₹150</strong></td></tr>
                <tr><td>Payment Method</td><td><span class="badge" style="<%= student.paymentMethod === 'online' ? 'background:#e0f2fe;color:#0369a1;' : 'background:#fef3c7;color:#92400e;' %>"><%= student.paymentMethod ? student.paymentMethod.toUpperCase() : 'ONLINE' %></span></td></tr>
                <tr><td>Payment Status</td><td><span class="badge <%= student.paymentStatus === 'paid' ? 'badge-success' : 'badge-warning' %>"><%= student.paymentStatus ? student.paymentStatus.toUpperCase() : 'PENDING' %></span></td></tr>
                <% if (payment) { %>
                  <% if (student.paymentMethod === 'cash') { %>
                    <tr><td>Cash Received Date</td><td><%= payment.cashPaymentDate ? new Date(payment.cashPaymentDate).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) : 'Pending Collection' %></td></tr>
                    <tr><td>Verified By</td><td><%= payment.cashVerifiedBy ? (payment.cashVerifiedBy.name + ' (' + payment.cashVerifiedBy.email + ')') : (student.paymentStatus === 'paid' ? 'Admin' : 'Pending Verification') %></td></tr>
                    <tr><td>Verification Note</td><td><%= payment.cashVerificationNote || 'N/A' %></td></tr>
                  <% } else { %>
                    <tr><td>Transaction / Order ID</td><td style="font-family:monospace;font-size:12px;"><%= payment.orderId || payment.razorpayOrderId || 'N/A' %></td></tr>
                    <tr><td>Payment Gateway ID</td><td style="font-family:monospace;font-size:12px;"><%= payment.paymentId || payment.razorpayPaymentId || 'N/A' %></td></tr>
                    <tr><td>Payment Date</td><td><%= payment.paymentDate ? new Date(payment.paymentDate).toLocaleDateString('en-IN', {day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) : 'N/A' %></td></tr>
                  <% } %>
                <% } %>
              </table>
            </div>
          </div>

          <!-- 7. Account Information -->
          <div class="card mb-24">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-lock"></i> Account Information</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Account Status</td><td><span class="badge <%= student.accountStatus === 'active' ? 'badge-success' : 'badge-warning' %>"><%= student.accountStatus ? student.accountStatus.toUpperCase() : 'PENDING' %></span></td></tr>
                <tr><td>Approval Status</td><td><span class="badge <%= student.approvalStatus === 'approved' ? 'badge-success' : 'badge-warning' %>"><%= student.approvalStatus ? student.approvalStatus.toUpperCase() : 'PENDING' %></span></td></tr>
                <tr><td>Email Notification</td><td><span class="badge badge-gray"><%= student.emailStatus ? student.emailStatus.toUpperCase() : 'PENDING' %></span></td></tr>
                <tr><td>Portal Login Access</td><td><strong><%= student.accountStatus === 'active' ? 'Granted (Email + Password)' : 'Blocked' %></strong></td></tr>
              </table>
            </div>
          </div>

          <!-- 8. System Information -->
          <div class="card">
            <div class="card-header"><div class="card-title"><i class="fa-solid fa-gear"></i> System Information</div></div>
            <div class="card-body">
              <table class="detail-info-table">
                <tr><td>Student ID</td><td><strong style="font-family:monospace;color:var(--primary);"><%= student.studentId || 'Not assigned yet' %></strong></td></tr>
                <tr><td>Database ID</td><td style="font-family:monospace;font-size:12px;color:var(--text-muted);"><%= student._id %></td></tr>
                <tr><td>Created At</td><td><%= new Date(student.createdAt).toLocaleString('en-IN') %></td></tr>
                <tr><td>Last Updated</td><td><%= new Date(student.updatedAt).toLocaleString('en-IN') %></td></tr>
              </table>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Student Modal -->
<div id="editStudentModal" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(15,23,42,0.65);backdrop-filter:blur(4px);z-index:99999;display:none;align-items:center;justify-content:center;padding:16px;">
  <div style="background:#ffffff;border-radius:18px;max-width:680px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-xl);border:1px solid var(--border);">
    
    <div style="background:linear-gradient(135deg, #0d1b6e 0%, #1a237e 100%);color:#fff;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;border-top-left-radius:17px;border-top-right-radius:17px;position:sticky;top:0;z-index:10;">
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:22px;"><i class="fa-solid fa-user-pen"></i></span>
        <div>
          <h3 style="margin:0;font-size:18px;font-weight:700;color:#fff;">Edit Student Registration</h3>
          <div style="font-size:12px;color:rgba(255,255,255,0.85);margin-top:2px;">Editing details for: <strong><%= student.fullName %></strong></div>
        </div>
      </div>
      <button type="button" onclick="closeEditStudentModal()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;">&times;</button>
    </div>

    <!-- Error Alert Box -->
    <div id="editStudentError" style="display:none;background:#fef2f2;border-left:4px solid #ef4444;color:#991b1b;padding:12px 18px;margin:16px 24px 0;border-radius:8px;font-size:13.5px;"></div>

    <form id="editStudentForm" onsubmit="saveStudentEdit(event)" style="padding:24px;">
      
      <!-- Read-only Student ID Banner -->
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 16px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div>
          <span style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;display:block;">Assigned Student ID</span>
          <strong style="font-family:monospace;font-size:17px;color:var(--primary);letter-spacing:1px;"><%= student.studentId || 'LIB (Pending)' %></strong>
        </div>
        <span class="badge badge-gray" style="font-size:11.5px;padding:5px 10px;">
          <i class="fa-solid fa-lock"></i> Permanent ID (Read-only)
        </span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        
        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Full Name *</label>
          <input type="text" name="fullName" class="form-control" value="<%= student.fullName %>" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Parent / Guardian Name *</label>
          <input type="text" name="parentName" class="form-control" value="<%= student.parentName %>" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Mobile Number * (10 digits)</label>
          <input type="tel" name="mobile" class="form-control" value="<%= student.mobile %>" required pattern="[0-9]{10}" maxlength="10" placeholder="10-digit number" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Email Address *</label>
          <input type="email" name="email" class="form-control" value="<%= student.email %>" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Date of Birth</label>
          <input type="date" name="dateOfBirth" class="form-control" value="<%= student.dateOfBirth ? new Date(student.dateOfBirth).toISOString().split('T')[0] : '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Gender</label>
          <select name="gender" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="male" <%= student.gender === 'male' ? 'selected' : '' %>>Male</option>
            <option value="female" <%= student.gender === 'female' ? 'selected' : '' %>>Female</option>
            <option value="other" <%= student.gender === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>

        <div style="grid-column:1/-1;">
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Residential Address</label>
          <input type="text" name="address" class="form-control" value="<%= student.address %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Emergency Contact</label>
          <input type="tel" name="emergencyContact" class="form-control" value="<%= student.emergencyContact || '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">ID Proof Type</label>
          <select name="idProofType" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="Aadhaar Card" <%= student.idProofType === 'Aadhaar Card' ? 'selected' : '' %>>Aadhaar Card</option>
            <option value="PAN Card" <%= student.idProofType === 'PAN Card' ? 'selected' : '' %>>PAN Card</option>
            <option value="Voter ID" <%= student.idProofType === 'Voter ID' ? 'selected' : '' %>>Voter ID</option>
            <option value="Driving License" <%= student.idProofType === 'Driving License' ? 'selected' : '' %>>Driving License</option>
            <option value="College ID" <%= student.idProofType === 'College ID' ? 'selected' : '' %>>College ID</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">ID Proof Number</label>
          <input type="text" name="idProofNumber" class="form-control" value="<%= student.idProofNumber || '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Education Level</label>
          <input type="text" name="educationLevel" class="form-control" value="<%= student.educationLevel || '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Preparing For</label>
          <input type="text" name="preparingFor" class="form-control" value="<%= student.preparingFor || '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Joining Date</label>
          <input type="date" name="joiningDate" class="form-control" value="<%= student.joiningDate ? new Date(student.joiningDate).toISOString().split('T')[0] : '' %>" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Membership Slot</label>
          <select name="membershipSlot" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="Full Day Slot (Unlimited)" <%= (student.membershipSlot === 'Full Day Slot (Unlimited)' || student.membershipSlot === 'Full Day Slot') ? 'selected' : '' %>>Full Day Slot (Unlimited)</option>
            <option value="Morning Shift (6:00 AM - 2:00 PM)" <%= student.membershipSlot === 'Morning Shift (6:00 AM - 2:00 PM)' ? 'selected' : '' %>>Morning Shift (6 AM - 2 PM)</option>
            <option value="Evening Shift (2:00 PM - 10:00 PM)" <%= student.membershipSlot === 'Evening Shift (2:00 PM - 10:00 PM)' ? 'selected' : '' %>>Evening Shift (2 PM - 10 PM)</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Subscription Plan</label>
          <select name="subscriptionPlan" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="1 Month Plan" <%= student.subscriptionPlan === '1 Month Plan' ? 'selected' : '' %>>1 Month Plan</option>
            <option value="2 Months Plan" <%= student.subscriptionPlan === '2 Months Plan' ? 'selected' : '' %>>2 Months Plan</option>
            <option value="3 Months Plan" <%= student.subscriptionPlan === '3 Months Plan' ? 'selected' : '' %>>3 Months Plan</option>
          </select>
        </div>

      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;border-top:1px solid var(--border);padding-top:16px;">
        <button type="button" class="btn btn-ghost" onclick="closeEditStudentModal()">Cancel</button>
        <button type="submit" id="saveEditStudentBtn" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
          <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
      </div>
    </form>

  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script src="/js/admin.js"></script>
<script>
  function openEditStudentModal() {
    const modal = document.getElementById('editStudentModal');
    const errBox = document.getElementById('editStudentError');
    if (errBox) errBox.style.display = 'none';
    if (modal) modal.style.display = 'flex';
  }

  function closeEditStudentModal() {
    const modal = document.getElementById('editStudentModal');
    if (modal) modal.style.display = 'none';
  }

  async function saveStudentEdit(e) {
    e.preventDefault();
    const form = document.getElementById('editStudentForm');
    const btn = document.getElementById('saveEditStudentBtn');
    const errBox = document.getElementById('editStudentError');
    if (errBox) errBox.style.display = 'none';

    const formData = new FormData(form);
    const payload = {};
    formData.forEach((value, key) => { payload[key] = value; });

    // Client-side phone format validation
    const mobileClean = (payload.mobile || '').replace(/\D/g, '');
    if (mobileClean.length !== 10) {
      if (errBox) {
        errBox.textContent = '❌ Please enter a valid 10-digit mobile number.';
        errBox.style.display = 'block';
      }
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving changes...';

    try {
      const res = await fetch('/admin/students/<%= student._id %>/edit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (data.success) {
        showToast('✅ ' + data.message, 'success');
        closeEditStudentModal();
        setTimeout(() => location.reload(), 800);
      } else {
        const errMsg = data.message || 'Error updating student details';
        if (errBox) {
          errBox.textContent = '❌ ' + errMsg;
          errBox.style.display = 'block';
        }
        showToast('❌ ' + errMsg, 'danger');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
      }
    } catch (err) {
      if (errBox) {
        errBox.textContent = '❌ Network or server error: ' + err.message;
        errBox.style.display = 'block';
      }
      showToast('❌ Server error: ' + err.message, 'danger');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
    }
  }

  // Auto-open modal if URL has ?edit=1 or #edit
  if (window.location.search.includes('edit=1') || window.location.hash === '#edit') {
    openEditStudentModal();
  }
</script>
</body>
</html>
