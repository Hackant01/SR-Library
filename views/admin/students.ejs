<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Students | <%= libraryName %> Admin</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
<div class="admin-wrapper">

  <%- include('./partials/sidebar', { currentPage: 'students' }) %>

  <div class="admin-main">
    <div class="admin-topbar">
      <button class="admin-sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
      <div class="admin-topbar-title">Manage Students</div>
      <div style="font-size:13px;color:var(--text-muted);"><span id="totalStudentsCount"><%= total %></span> total records</div>
    </div>

    <div class="admin-content">

      <!-- Toolbar: Search & Filters -->
      <form id="filterForm" method="GET" action="/admin/students">
        <div class="admin-table-toolbar" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <!-- Search input -->
          <div class="search-input-wrapper" style="flex:1;min-width:240px;position:relative;">
            <span class="search-icon" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="Search by name, email, mobile, student ID..."
              value="<%= search %>"
              id="searchInput"
              style="padding-left:36px;"
            />
          </div>

          <!-- Payment Method Filter -->
          <select name="method" class="form-control filter-select" onchange="this.form.submit()">
            <option value="">Payment Method: All</option>
            <option value="online" <%= (typeof method !== 'undefined' && method === 'online') ? 'selected' : '' %>>Online</option>
            <option value="cash" <%= (typeof method !== 'undefined' && method === 'cash') ? 'selected' : '' %>>Cash</option>
          </select>

          <!-- Payment Status Filter -->
          <select name="payment" class="form-control filter-select" onchange="this.form.submit()">
            <option value="">Payment Status: All</option>
            <option value="paid" <%= payment === 'paid' ? 'selected' : '' %>>Paid</option>
            <option value="pending" <%= payment === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="failed" <%= payment === 'failed' ? 'selected' : '' %>>Failed</option>
          </select>

          <!-- Account Status Filter -->
          <select name="status" class="form-control filter-select" onchange="this.form.submit()">
            <option value="">Account Status: All</option>
            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>

          <!-- Approval Status Filter -->
          <select name="approval" class="form-control filter-select" onchange="this.form.submit()">
            <option value="">Approval Status: All</option>
            <option value="approved" <%= approval === 'approved' ? 'selected' : '' %>>Approved</option>
            <option value="pending" <%= approval === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="rejected" <%= approval === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>

          <!-- Sort Filter -->
          <select name="sort" class="form-control filter-select" onchange="this.form.submit()">
            <option value="-createdAt" <%= sortBy === '-createdAt' ? 'selected' : '' %>>Newest First</option>
            <option value="createdAt" <%= sortBy === 'createdAt' ? 'selected' : '' %>>Oldest First</option>
            <option value="fullName" <%= sortBy === 'fullName' ? 'selected' : '' %>>Name A-Z</option>
            <option value="-fullName" <%= sortBy === '-fullName' ? 'selected' : '' %>>Name Z-A</option>
          </select>

          <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filter</button>
          <a href="/admin/students" class="btn btn-ghost btn-sm"><i class="fa-solid fa-rotate-left"></i> Reset</a>
        </div>
      </form>

      <!-- Student Table Card -->
      <div class="card">
        <div class="table-wrapper" style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
          <table class="table responsive-card-table" id="studentsTable">
            <thead>
              <tr>
                <th style="width:40px;">#</th>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Reg. Date</th>
                <th>Joining Date</th>
                <th>Payment Method</th>
                <th>Payment Status</th>
                <th>Approval Status</th>
                <th>Account Status</th>
                <th style="min-width:200px;text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (students.length === 0) { %>
                <tr>
                  <td colspan="12" style="text-align:center;padding:48px;color:var(--text-muted);">
                    No students found matching your criteria.
                  </td>
                </tr>
              <% } else { %>
                <% students.forEach((s, i) => { %>
                <tr id="student-row-<%= s._id %>">
                  <td data-label="#"> <%= (page - 1) * limit + i + 1 %></td>
                  <td data-label="Student ID">
                    <% if (s.studentId) { %>
                      <span style="font-family:monospace;font-weight:700;color:var(--primary);letter-spacing:0.5px;"><%= s.studentId %></span>
                    <% } else { %>
                      <span style="color:var(--text-light);font-style:italic;font-size:13px;">Not Assigned</span>
                    <% } %>
                  </td>
                  <td data-label="Name">
                    <div style="display:flex;align-items:center;gap:8px;">
                      <div class="avatar-circle" style="width:32px;height:32px;font-size:13px;flex-shrink:0;"><%= s.fullName.charAt(0).toUpperCase() %></div>
                      <div>
                        <div style="font-weight:600;font-size:14px;"><%= s.fullName %></div>
                        <div style="font-size:12px;color:var(--text-muted);text-transform:capitalize;"><%= s.gender || '' %></div>
                      </div>
                    </div>
                  </td>
                  <td data-label="Email" style="font-size:13px;max-width:160px;overflow:hidden;text-overflow:ellipsis;"><%= s.email %></td>
                  <td data-label="Mobile"><%= s.mobile %></td>
                  <td data-label="Reg. Date"><%= new Date(s.registrationDate || s.createdAt).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
                  <td data-label="Joining Date"><%= new Date(s.joiningDate).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
                  <td data-label="Payment Method">
                    <% if (s.paymentMethod === 'online') { %>
                      <span class="badge" style="background:#e0f2fe;color:#0369a1;font-weight:600;"><i class="fa-solid fa-credit-card"></i> Online</span>
                    <% } else { %>
                      <span class="badge" style="background:#fef3c7;color:#92400e;font-weight:600;"><i class="fa-solid fa-money-bill-wave"></i> Cash</span>
                    <% } %>
                  </td>
                  <td data-label="Payment Status">
                    <% if (s.paymentStatus === 'paid') { %>
                      <span class="badge badge-success"><i class="fa-solid fa-check"></i> Paid</span>
                    <% } else if (s.paymentStatus === 'failed') { %>
                      <span class="badge badge-danger">Failed</span>
                    <% } else { %>
                      <span class="badge badge-warning" style="background:#fff7ed;color:#c2410c;border:1px solid #ffedd5;">Pending</span>
                    <% } %>
                  </td>
                  <td data-label="Approval">
                    <% if (s.approvalStatus === 'approved') { %>
                      <span class="badge badge-success">Approved</span>
                    <% } else if (s.approvalStatus === 'rejected') { %>
                      <span class="badge badge-danger">Rejected</span>
                    <% } else { %>
                      <span class="badge badge-warning">Pending</span>
                    <% } %>
                  </td>
                  <td data-label="Status" id="account-status-cell-<%= s._id %>">
                    <% if (s.accountStatus === 'active') { %>
                      <span class="badge badge-success"><i class="fa-solid fa-check"></i> Active</span>
                    <% } else if (s.accountStatus === 'pending') { %>
                      <span class="badge badge-warning" style="background:#fff8e1;color:#b78103;border:1px solid #ffe082;">⏳ Pending</span>
                    <% } else if (s.accountStatus === 'rejected') { %>
                      <span class="badge badge-danger"><i class="fa-solid fa-xmark"></i> Rejected</span>
                    <% } else { %>
                      <span class="badge badge-gray">Inactive</span>
                    <% } %>
                  </td>
                  <td data-label="Actions" style="text-align:right;">
                    <div class="action-btn-group" id="action-group-<%= s._id %>">
                      <!-- Primary Action 1: Details -->
                      <a href="/admin/students/<%= s._id %>" class="btn btn-sm btn-info" title="View Details" style="padding:6px 10px;font-size:12px;">
                        <i class="fa-solid fa-eye"></i> Details
                      </a>

                      <!-- Primary Action 2: Print Form -->
                      <a href="/admin/students/<%= s._id %>/print" target="_blank" class="btn btn-sm btn-primary" title="Print Membership Form" style="background:#4f46e5;color:#fff;padding:6px 10px;font-size:12px;">
                        <i class="fa-solid fa-print"></i> Print
                      </a>

                      <!-- Secondary Actions Dropdown Menu -->
                      <div class="actions-dropdown-container">
                        <button type="button" class="btn btn-sm btn-ghost" onclick="toggleActionMenu('<%= s._id %>', event)" title="More Actions" style="padding:6px 10px;font-size:12px;border:1px solid var(--border);">
                          <i class="fa-solid fa-ellipsis-vertical"></i> Actions ▾
                        </button>
                        <div class="action-dropdown-menu" id="action-menu-<%= s._id %>">
                          
                          <button type="button" class="action-dropdown-item" onclick="openEditStudentModalFromTable('<%= s._id %>')" style="color:var(--primary);font-weight:600;width:100%;text-align:left;background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:8px;padding:8px 12px;font-size:13px;">
                            <i class="fa-solid fa-pen-to-square"></i> Edit Details
                          </button>

                          <!-- Pending Cash verification action -->
                          <% if (s.paymentMethod === 'cash' && s.paymentStatus === 'pending') { %>
                            <button type="button" class="action-dropdown-item text-success" onclick="openCashModal('<%= s._id %>','<%= s.fullName %>')">
                              <i class="fa-solid fa-money-bill-wave"></i> Mark Cash Paid
                            </button>
                          <% } %>

                          <!-- Activate / Deactivate Toggle -->
                          <% if (s.accountStatus === 'active') { %>
                            <button type="button" class="action-dropdown-item text-warning" id="status-btn-<%= s._id %>" onclick="deactivateStudent('<%= s._id %>','<%= s.fullName %>', this)">
                              <i class="fa-solid fa-pause"></i> Deactivate Account
                            </button>
                          <% } else { %>
                            <button type="button" class="action-dropdown-item text-success" id="status-btn-<%= s._id %>" onclick="activateStudent('<%= s._id %>','<%= s.fullName %>', this)">
                              <i class="fa-solid fa-play"></i> Activate Account
                            </button>
                          <% } %>

                          <!-- Resend Email -->
                          <button type="button" class="action-dropdown-item" onclick="resendEmail('<%= s._id %>','<%= s.fullName %>', this)">
                            <i class="fa-solid fa-paper-plane"></i> <%= s.emailStatus === 'sent' ? 'Resend Welcome Email' : 'Send Welcome Email' %>
                          </button>

                          <!-- Permanent Delete -->
                          <button type="button" class="action-dropdown-item text-danger" onclick="confirmDeleteStudent('<%= s._id %>','<%= s.fullName %>')">
                            <i class="fa-solid fa-trash"></i> Delete Student
                          </button>
                        </div>
                      </div>

                    </div>
                  </td>
                </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
        <div style="padding:16px 20px;border-top:1px solid var(--border);">
          <div class="pagination">
            <% const baseQuery = `search=${encodeURIComponent(search)}&method=${encodeURIComponent(method)}&status=${encodeURIComponent(status)}&payment=${encodeURIComponent(payment)}&approval=${encodeURIComponent(approval)}&sort=${encodeURIComponent(sortBy)}`; %>
            
            <% if (page > 1) { %>
              <a href="?page=1&<%= baseQuery %>" class="page-btn">«</a>
              <a href="?page=<%= page-1 %>&<%= baseQuery %>" class="page-btn">‹</a>
            <% } %>

            <% for (let p = Math.max(1, page-2); p <= Math.min(totalPages, page+2); p++) { %>
              <a href="?page=<%= p %>&<%= baseQuery %>" class="page-btn <%= p === page ? 'active' : '' %>"><%= p %></a>
            <% } %>

            <% if (page < totalPages) { %>
              <a href="?page=<%= page+1 %>&<%= baseQuery %>" class="page-btn">›</a>
              <a href="?page=<%= totalPages %>&<%= baseQuery %>" class="page-btn">»</a>
            <% } %>
          </div>
          <div style="text-align:center;font-size:13px;color:var(--text-muted);margin-top:8px;">
            Showing <%= (page-1)*limit + 1 %>–<%= Math.min(page*limit, total) %> of <%= total %> records
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Table Edit Student Modal -->
<div id="tableEditStudentModal" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(15,23,42,0.65);backdrop-filter:blur(4px);z-index:99999;display:none;align-items:center;justify-content:center;padding:16px;">
  <div style="background:#ffffff;border-radius:18px;max-width:680px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:var(--shadow-xl);border:1px solid var(--border);">
    
    <div style="background:linear-gradient(135deg, #0d1b6e 0%, #1a237e 100%);color:#fff;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;border-top-left-radius:17px;border-top-right-radius:17px;position:sticky;top:0;z-index:10;">
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="font-size:22px;"><i class="fa-solid fa-user-pen"></i></span>
        <div>
          <h3 style="margin:0;font-size:18px;font-weight:700;color:#fff;">Edit Student Registration</h3>
          <div style="font-size:12px;color:rgba(255,255,255,0.85);margin-top:2px;">Editing details for: <strong id="tableEditStudentNameTitle">Loading...</strong></div>
        </div>
      </div>
      <button type="button" onclick="closeEditStudentModalTable()" style="background:rgba(255,255,255,0.15);border:none;color:#fff;width:32px;height:32px;border-radius:8px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;">&times;</button>
    </div>

    <!-- Error Alert Box -->
    <div id="tableEditStudentError" style="display:none;background:#fef2f2;border-left:4px solid #ef4444;color:#991b1b;padding:12px 18px;margin:16px 24px 0;border-radius:8px;font-size:13.5px;"></div>

    <!-- Loading Spinner inside modal -->
    <div id="tableEditStudentLoading" style="padding:48px 24px;text-align:center;color:var(--text-muted);">
      <i class="fa-solid fa-spinner fa-spin fa-2x" style="color:var(--primary);"></i>
      <div style="margin-top:12px;font-size:14px;font-weight:600;">Loading student details...</div>
    </div>

    <form id="tableEditStudentForm" onsubmit="saveStudentEditFromTable(event)" style="padding:24px;display:none;">
      
      <!-- Read-only Student ID Banner -->
      <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 16px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div>
          <span style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#64748b;font-weight:700;display:block;">Assigned Student ID</span>
          <strong id="tableEditStudentIdVal" style="font-family:monospace;font-size:17px;color:var(--primary);letter-spacing:1px;">LIB</strong>
        </div>
        <span class="badge badge-gray" style="font-size:11.5px;padding:5px 10px;">
          <i class="fa-solid fa-lock"></i> Permanent ID (Read-only)
        </span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        
        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Full Name *</label>
          <input type="text" id="tableEdit_fullName" name="fullName" class="form-control" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Parent / Guardian Name *</label>
          <input type="text" id="tableEdit_parentName" name="parentName" class="form-control" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Mobile Number * (10 digits)</label>
          <input type="tel" id="tableEdit_mobile" name="mobile" class="form-control" required pattern="[0-9]{10}" maxlength="10" placeholder="10-digit number" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Email Address *</label>
          <input type="email" id="tableEdit_email" name="email" class="form-control" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Date of Birth</label>
          <input type="date" id="tableEdit_dateOfBirth" name="dateOfBirth" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Gender</label>
          <select id="tableEdit_gender" name="gender" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div style="grid-column:1/-1;">
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Residential Address</label>
          <input type="text" id="tableEdit_address" name="address" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Emergency Contact</label>
          <input type="tel" id="tableEdit_emergencyContact" name="emergencyContact" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">ID Proof Type</label>
          <select id="tableEdit_idProofType" name="idProofType" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="Aadhaar Card">Aadhaar Card</option>
            <option value="PAN Card">PAN Card</option>
            <option value="Voter ID">Voter ID</option>
            <option value="Driving License">Driving License</option>
            <option value="College ID">College ID</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">ID Proof Number</label>
          <input type="text" id="tableEdit_idProofNumber" name="idProofNumber" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Education Level</label>
          <input type="text" id="tableEdit_educationLevel" name="educationLevel" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Preparing For</label>
          <input type="text" id="tableEdit_preparingFor" name="preparingFor" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Joining Date</label>
          <input type="date" id="tableEdit_joiningDate" name="joiningDate" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;" />
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Membership Slot</label>
          <select id="tableEdit_membershipSlot" name="membershipSlot" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="Full Day Slot (Unlimited)">Full Day Slot (Unlimited)</option>
            <option value="Morning Shift (6:00 AM - 2:00 PM)">Morning Shift (6 AM - 2 PM)</option>
            <option value="Evening Shift (2:00 PM - 10:00 PM)">Evening Shift (2 PM - 10 PM)</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;">Subscription Plan</label>
          <select id="tableEdit_subscriptionPlan" name="subscriptionPlan" class="form-control" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:13.5px;background:#fff;">
            <option value="1 Month Plan">1 Month Plan</option>
            <option value="2 Months Plan">2 Months Plan</option>
            <option value="3 Months Plan">3 Months Plan</option>
          </select>
        </div>

      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:24px;border-top:1px solid var(--border);padding-top:16px;">
        <button type="button" class="btn btn-ghost" onclick="closeEditStudentModalTable()">Cancel</button>
        <button type="submit" id="saveTableEditStudentBtn" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
          <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
      </div>
    </form>

  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script src="/js/admin.js"></script>
<script>
// Search debounce
const searchInput = document.getElementById('searchInput');
if (searchInput) {
  let searchTimer;
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => document.getElementById('filterForm')?.submit(), 700);
  });
}

// Action dropdown menu toggling
function toggleActionMenu(id, e) {
  if (e) {
    e.stopPropagation();
  }
  const menu = document.getElementById(`action-menu-${id}`);
  const isAlreadyActive = menu && menu.classList.contains('active');
  document.querySelectorAll('.action-dropdown-menu').forEach(m => m.classList.remove('active'));
  if (menu && !isAlreadyActive) {
    menu.classList.add('active');
  }
}

document.addEventListener('click', () => {
  document.querySelectorAll('.action-dropdown-menu').forEach(m => m.classList.remove('active'));
});

// ─── Table Edit Student Modal Workflow ─────────────────────────────
let currentEditingStudentId = null;

async function openEditStudentModalFromTable(studentId) {
  currentEditingStudentId = studentId;
  const modal = document.getElementById('tableEditStudentModal');
  const loading = document.getElementById('tableEditStudentLoading');
  const form = document.getElementById('tableEditStudentForm');
  const errBox = document.getElementById('tableEditStudentError');

  if (errBox) errBox.style.display = 'none';
  if (loading) loading.style.display = 'block';
  if (form) form.style.display = 'none';
  if (modal) modal.style.display = 'flex';

  // Close any open action menu
  document.querySelectorAll('.action-dropdown-menu').forEach(m => m.classList.remove('active'));

  try {
    const res = await fetch(`/admin/api/students/${studentId}`);
    const data = await res.json();

    if (!data.success || !data.student) {
      if (errBox) {
        errBox.textContent = '❌ ' + (data.message || 'Failed to load student details.');
        errBox.style.display = 'block';
      }
      if (loading) loading.style.display = 'none';
      return;
    }

    const s = data.student;
    document.getElementById('tableEditStudentNameTitle').textContent = s.fullName || 'Student';
    document.getElementById('tableEditStudentIdVal').textContent = s.studentId || 'LIB (Pending)';

    document.getElementById('tableEdit_fullName').value = s.fullName || '';
    document.getElementById('tableEdit_parentName').value = s.parentName || '';
    document.getElementById('tableEdit_mobile').value = s.mobile || '';
    document.getElementById('tableEdit_email').value = s.email || '';
    document.getElementById('tableEdit_dateOfBirth').value = s.dateOfBirth ? s.dateOfBirth.split('T')[0] : '';
    document.getElementById('tableEdit_gender').value = s.gender || 'male';
    document.getElementById('tableEdit_address').value = s.address || '';
    document.getElementById('tableEdit_emergencyContact').value = s.emergencyContact || '';
    document.getElementById('tableEdit_idProofType').value = s.idProofType || 'Aadhaar Card';
    document.getElementById('tableEdit_idProofNumber').value = s.idProofNumber || '';
    document.getElementById('tableEdit_educationLevel').value = s.educationLevel || '';
    document.getElementById('tableEdit_preparingFor').value = s.preparingFor || '';
    document.getElementById('tableEdit_joiningDate').value = s.joiningDate ? s.joiningDate.split('T')[0] : '';
    
    if (document.getElementById('tableEdit_membershipSlot')) {
      document.getElementById('tableEdit_membershipSlot').value = s.membershipSlot || 'Full Day Slot (Unlimited)';
    }
    if (document.getElementById('tableEdit_subscriptionPlan')) {
      document.getElementById('tableEdit_subscriptionPlan').value = s.subscriptionPlan || '1 Month Plan';
    }

    if (loading) loading.style.display = 'none';
    if (form) form.style.display = 'block';
  } catch (err) {
    if (errBox) {
      errBox.textContent = '❌ Network error loading student details: ' + err.message;
      errBox.style.display = 'block';
    }
    if (loading) loading.style.display = 'none';
  }
}

function closeEditStudentModalTable() {
  const modal = document.getElementById('tableEditStudentModal');
  if (modal) modal.style.display = 'none';
  currentEditingStudentId = null;
}

async function saveStudentEditFromTable(e) {
  e.preventDefault();
  if (!currentEditingStudentId) return;

  const form = document.getElementById('tableEditStudentForm');
  const btn = document.getElementById('saveTableEditStudentBtn');
  const errBox = document.getElementById('tableEditStudentError');
  if (errBox) errBox.style.display = 'none';

  const formData = new FormData(form);
  const payload = {};
  formData.forEach((value, key) => { payload[key] = value; });

  const mobileClean = (payload.mobile || '').replace(/\D/g, '');
  if (mobileClean.length !== 10) {
    if (errBox) {
      errBox.textContent = '❌ Please enter a valid 10-digit mobile number.';
      errBox.style.display = 'block';
    }
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving changes...';

  try {
    const res = await fetch(`/admin/students/${currentEditingStudentId}/edit`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
      },
      body: JSON.stringify(payload),
    });

    const data = await res.json();
    if (data.success) {
      showToast('✅ ' + data.message, 'success');
      closeEditStudentModalTable();
      setTimeout(() => location.reload(), 800);
    } else {
      const errMsg = data.message || 'Error updating student details';
      if (errBox) {
        errBox.textContent = '❌ ' + errMsg;
        errBox.style.display = 'block';
      }
      showToast('❌ ' + errMsg, 'danger');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
    }
  } catch (err) {
    if (errBox) {
      errBox.textContent = '❌ Server connection error: ' + err.message;
      errBox.style.display = 'block';
    }
    showToast('❌ Server error: ' + err.message, 'danger');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Changes';
  }
}
</script>
